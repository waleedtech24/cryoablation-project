@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login – SCM Co-Ablation System</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --blue: #4169e1;
            --blue-dark: #2d4fc7;
            --blue-light: #eef2ff;
            --text: #1e293b;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --white: #ffffff;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #dce8ff 0%, #eaf0ff 50%, #d8e6ff 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
        }

        /* ── Background Medical Icons ── */
        .bg-icons {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
        }

        .bg-icon {
            position: absolute;
            color: rgba(65, 105, 225, 0.075);
            animation: float ease-in-out infinite;
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-12px) rotate(4deg);
            }
        }

        .bi1 {
            top: 5%;
            left: 3%;
            font-size: 3.4rem;
            animation-duration: 8s;
            animation-delay: 0s;
        }

        .bi2 {
            top: 10%;
            left: 19%;
            font-size: 2.2rem;
            animation-duration: 10s;
            animation-delay: 1.2s;
        }

        .bi3 {
            top: 4%;
            right: 4%;
            font-size: 3.8rem;
            animation-duration: 7s;
            animation-delay: 2s;
        }

        .bi4 {
            top: 20%;
            right: 15%;
            font-size: 2rem;
            animation-duration: 9s;
            animation-delay: 0.6s;
        }

        .bi5 {
            top: 44%;
            left: 1%;
            font-size: 4rem;
            animation-duration: 11s;
            animation-delay: 3s;
        }

        .bi6 {
            top: 52%;
            left: 15%;
            font-size: 2.4rem;
            animation-duration: 8s;
            animation-delay: 1.8s;
        }

        .bi7 {
            top: 38%;
            right: 2%;
            font-size: 3.6rem;
            animation-duration: 9s;
            animation-delay: 2.8s;
        }

        .bi8 {
            top: 56%;
            right: 14%;
            font-size: 2rem;
            animation-duration: 7s;
            animation-delay: 0.9s;
        }

        .bi9 {
            bottom: 12%;
            left: 5%;
            font-size: 3.2rem;
            animation-duration: 8s;
            animation-delay: 4s;
        }

        .bi10 {
            bottom: 7%;
            right: 6%;
            font-size: 2.8rem;
            animation-duration: 12s;
            animation-delay: 1.5s;
        }

        .bi11 {
            bottom: 24%;
            left: 18%;
            font-size: 2rem;
            animation-duration: 9s;
            animation-delay: 3.8s;
        }

        .bi12 {
            bottom: 18%;
            right: 18%;
            font-size: 2.6rem;
            animation-duration: 7s;
            animation-delay: 2.2s;
        }

        .bi13 {
            top: 28%;
            left: 7%;
            font-size: 2.2rem;
            animation-duration: 10s;
            animation-delay: 0.4s;
        }

        .bi14 {
            top: 68%;
            right: 7%;
            font-size: 2.8rem;
            animation-duration: 8s;
            animation-delay: 2s;
        }

        /* ── Card ── */
        .login-card {
            width: 100%;
            max-width: 940px;
            background: var(--white);
            border-radius: 1.25rem;
            box-shadow: 0 20px 60px rgba(65,105,225,0.18), 0 4px 16px rgba(0,0,0,0.07);
            display: flex;
            overflow: hidden;
            min-height: 600px;
            position: relative;
            z-index: 1;
            animation: card-in .5s cubic-bezier(.22,1,.36,1) forwards;
        }

        @@keyframes card-in {
            from {
                opacity: 0;
                transform: translateY(22px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ── Left Brand Panel ── */
        .brand-panel {
            width: 360px;
            flex-shrink: 0;
            background: linear-gradient(160deg, var(--blue) 0%, var(--blue-dark) 55%, #1a3599 100%);
            padding: 2.8rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

            .brand-panel::before {
                content: '';
                position: absolute;
                top: -60px;
                right: -60px;
                width: 220px;
                height: 220px;
                border-radius: 50%;
                background: rgba(255,255,255,0.06);
                pointer-events: none;
            }

            .brand-panel::after {
                content: '';
                position: absolute;
                bottom: -40px;
                left: -40px;
                width: 160px;
                height: 160px;
                border-radius: 50%;
                background: rgba(255,255,255,0.05);
                pointer-events: none;
            }

        .brand-top {
            position: relative;
            z-index: 1;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin-bottom: 1.8rem;
        }

        .logo-icon {
            width: 46px;
            height: 46px;
            background: rgba(255,255,255,0.15);
            border: 2px solid rgba(255,255,255,0.25);
            border-radius: .75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #fff;
        }

        .brand-name-text {
            color: #fff;
            font-weight: 700;
            font-size: .95rem;
            line-height: 1.2;
        }

            .brand-name-text span {
                display: block;
                font-weight: 400;
                font-size: .68rem;
                color: rgba(255,255,255,.6);
                letter-spacing: .05em;
            }

        .cryo-badge {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: .5rem;
            padding: .4rem .8rem;
            font-size: .7rem;
            color: rgba(255,255,255,.85);
            margin-bottom: 1rem;
            letter-spacing: .04em;
            font-weight: 500;
        }

        .brand-headline {
            color: #fff;
            font-size: 1.3rem;
            font-weight: 700;
            line-height: 1.35;
            margin-bottom: .6rem;
        }

        .brand-sub {
            color: rgba(255,255,255,.6);
            font-size: .78rem;
            line-height: 1.6;
            font-weight: 300;
            margin-bottom: 1.5rem;
        }

        /* Procedure type stats */
        .proc-stats {
            display: flex;
            gap: .6rem;
            margin-bottom: 1.5rem;
        }

        .pstat {
            flex: 1;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: .6rem;
            padding: .6rem .5rem;
            text-align: center;
        }

        .pstat-val {
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
            line-height: 1;
        }

        .pstat-lbl {
            color: rgba(255,255,255,.5);
            font-size: .58rem;
            margin-top: .3rem;
            letter-spacing: .03em;
        }

        /* Feature list */
        .feature-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: .6rem;
            position: relative;
            z-index: 1;
        }

            .feature-list li {
                display: flex;
                align-items: center;
                gap: .65rem;
                color: rgba(255,255,255,.85);
                font-size: .78rem;
            }

                .feature-list li .fi {
                    width: 26px;
                    height: 26px;
                    border-radius: .45rem;
                    background: rgba(255,255,255,.12);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: .7rem;
                    color: #fff;
                    flex-shrink: 0;
                }

        /* Bottom */
        .bottom-area {
            position: relative;
            z-index: 1;
        }

        .divider-line {
            height: 1px;
            background: rgba(255,255,255,.12);
            margin-bottom: 1rem;
        }

        .med-chips {
            display: flex;
            gap: .5rem;
            flex-wrap: wrap;
        }

        .med-chip {
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: .4rem;
            padding: .3rem .6rem;
            font-size: .65rem;
            color: rgba(255,255,255,.75);
            display: flex;
            align-items: center;
            gap: .3rem;
        }

        /* ── Right Form Panel ── */
        .form-panel {
            flex: 1;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-eyebrow {
            font-size: .68rem;
            font-weight: 600;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: var(--blue);
            margin-bottom: .5rem;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

            .form-eyebrow::before {
                content: '';
                width: 20px;
                height: 2px;
                background: var(--blue);
                border-radius: 1px;
            }

        .form-title {
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: .3rem;
        }

        .form-subtitle {
            font-size: .83rem;
            color: var(--text-muted);
            margin-bottom: 1.8rem;
        }

        /* Validation */
        .validation-summary-errors {
            background: #fff5f5;
            border: 1.5px solid #fca5a5;
            border-radius: .6rem;
            padding: .75rem 1rem;
            margin-bottom: 1.2rem;
            font-size: .8rem;
            color: #dc2626;
        }

        .validation-summary-valid {
            display: none;
        }

        .field-validation-error {
            font-size: .73rem;
            color: #dc2626;
            margin-top: .3rem;
            display: block;
        }

        .input-validation-error {
            border-color: #fca5a5 !important;
        }

        .fg {
            margin-bottom: 1.15rem;
        }

            .fg label {
                display: block;
                font-size: .73rem;
                font-weight: 600;
                color: var(--text);
                margin-bottom: .42rem;
            }

        .input-box {
            position: relative;
            display: flex;
            align-items: center;
        }

            .input-box .ii {
                position: absolute;
                left: .9rem;
                color: var(--text-muted);
                font-size: .82rem;
                pointer-events: none;
                transition: color .2s;
            }

            .input-box:focus-within .ii {
                color: var(--blue);
            }

            .input-box input[type="text"],
            .input-box input[type="email"],
            .input-box input[type="password"] {
                width: 100%;
                border: 1.5px solid var(--border);
                border-radius: .6rem;
                padding: .7rem 2.5rem .7rem 2.5rem;
                font-family: 'Inter', sans-serif;
                font-size: .87rem;
                color: var(--text);
                background: var(--white);
                outline: none;
                transition: border-color .2s, box-shadow .2s;
            }

            .input-box input:focus {
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(65,105,225,.12);
            }

            .input-box input::placeholder {
                color: #cbd5e1;
            }

        .eye-btn {
            position: absolute;
            right: .9rem;
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: .82rem;
            padding: 0;
            transition: color .2s;
        }

            .eye-btn:hover {
                color: var(--blue);
            }

        .form-row {
            display: flex;
            align-items: center;
            margin-bottom: 1.4rem;
            margin-top: .3rem;
        }

        .check-label {
            display: flex;
            align-items: center;
            gap: .45rem;
            font-size: .78rem;
            color: var(--text-muted);
            cursor: pointer;
        }

            .check-label input[type="checkbox"] {
                accent-color: var(--blue);
                width: 14px;
                height: 14px;
            }

        .btn-submit {
            width: 100%;
            padding: .8rem;
            background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
            border: none;
            border-radius: .6rem;
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: .9rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            transition: transform .15s, box-shadow .15s;
            box-shadow: 0 4px 16px rgba(65,105,225,.35);
            margin-bottom: 1.1rem;
            position: relative;
            overflow: hidden;
        }

            .btn-submit::after {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,.15), transparent);
                transition: left .5s;
            }

            .btn-submit:hover::after {
                left: 100%;
            }

            .btn-submit:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 24px rgba(65,105,225,.4);
            }

            .btn-submit:active {
                transform: translateY(0);
            }

        /* Trust row */
        .trust-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            padding: .65rem 1rem;
            background: #f8faff;
            border: 1px solid #e8eeff;
            border-radius: .6rem;
            margin-bottom: 1.4rem;
            flex-wrap: wrap;
        }

        .trust-item {
            display: flex;
            align-items: center;
            gap: .32rem;
            font-size: .68rem;
            color: #4a6fd4;
            font-weight: 500;
        }

            .trust-item i {
                font-size: .65rem;
            }

        .form-footer {
            text-align: center;
            font-size: .68rem;
            color: #94a3b8;
            border-top: 1px solid var(--border);
            padding-top: 1rem;
        }

        @@media (max-width: 700px) {
            body {
                padding: 1rem;
            }

            .brand-panel {
                display: none;
            }

            .form-panel {
                padding: 2rem 1.5rem;
            }
        }
    </style>
</head>
<body>

    <!-- ── Background Icons — Cryo/Medical Specific ── -->
    <div class="bg-icons">
        <i class="fas fa-snowflake       bg-icon bi1"></i>
        <i class="fas fa-syringe         bg-icon bi2"></i>
        <i class="fas fa-dna             bg-icon bi3"></i>
        <i class="fas fa-vial            bg-icon bi4"></i>
        <i class="fas fa-microscope      bg-icon bi5"></i>
        <i class="fas fa-lungs           bg-icon bi6"></i>
        <i class="fas fa-radiation       bg-icon bi7"></i>
        <i class="fas fa-temperature-low bg-icon bi8"></i>
        <i class="fas fa-flask           bg-icon bi9"></i>
        <i class="fas fa-stethoscope     bg-icon bi10"></i>
        <i class="fas fa-file-medical    bg-icon bi11"></i>
        <i class="fas fa-hospital        bg-icon bi12"></i>
        <i class="fas fa-heart-pulse     bg-icon bi13"></i>
        <i class="fas fa-user-doctor     bg-icon bi14"></i>
    </div>

    <div class="login-card">

        <!-- ── Left Brand Panel ── -->
        <div class="brand-panel">
            <div class="brand-top">

                <div class="brand-logo">
                   <div class="logo-icon">
  <svg viewBox="0 0 40 40" width="28" height="28">
    <rect x="14" y="3"  width="12" height="34" rx="4" fill="rgba(255,255,255,0.2)"/>
    <rect x="3"  y="14" width="34" height="12" rx="4" fill="rgba(255,255,255,0.2)"/>
    <line x1="20" y1="10" x2="20" y2="30" stroke="#fff" stroke-width="2.8" stroke-linecap="round"/>
    <line x1="10" y1="20" x2="30" y2="20" stroke="#fff" stroke-width="2.8" stroke-linecap="round"/>
    <line x1="13" y1="13" x2="27" y2="27" stroke="rgba(255,255,255,.55)" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="27" y1="13" x2="13" y2="27" stroke="rgba(255,255,255,.55)" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="20" y1="10" x2="16.5" y2="14" stroke="#7dd3fc" stroke-width="1.6" stroke-linecap="round"/>
    <line x1="20" y1="10" x2="23.5" y2="14" stroke="#7dd3fc" stroke-width="1.6" stroke-linecap="round"/>
    <line x1="20" y1="30" x2="16.5" y2="26" stroke="#7dd3fc" stroke-width="1.6" stroke-linecap="round"/>
    <line x1="20" y1="30" x2="23.5" y2="26" stroke="#7dd3fc" stroke-width="1.6" stroke-linecap="round"/>
    <circle cx="20" cy="20" r="3.5" fill="#7dd3fc"/>
    <circle cx="20" cy="20" r="1.6" fill="#fff"/>
  </svg>
</div>
                    <div class="brand-name-text">
                        SCM Co-Ablation
                        <span>Cryoablation Management System</span>
                    </div>
                </div>

                <div class="cryo-badge">
                    <i class="fas fa-temperature-low"></i> Cryoablation Cancer Care Portal
                </div>

          @*       <div class="brand-headline">Advanced Tumor<br />Ablation Management</div> *@
                <div class="brand-sub">
                    Managing probe, procedures, patient oncology records, sterilization logs, and ethanol inventory — all in one place.
                </div>

                <!-- Procedure type icons -->
                <div class="proc-stats">
                    <div class="pstat">
                        <div class="pstat-val"><i class="fas fa-user-injured" style="font-size:.75rem;opacity:.8;"></i></div>
                        <div class="pstat-lbl">Patients Record</div>
                    </div>
                    <div class="pstat">
                        <div class="pstat-val"><i class="fas fa-syringe" style="font-size:.75rem;opacity:.8;"></i></div>
                        <div class="pstat-lbl">Probe Tracking</div>
                    </div>
                    <div class="pstat">
                        <div class="pstat-val"><i class="fas fa-vial" style="font-size:.75rem;opacity:.8;"></i></div>
                        <div class="pstat-lbl">Ethanol &amp; Liquids</div>
                    </div>
                </div>

                <ul class="feature-list">
                    <li><span class="fi"><i class="fas fa-user-injured"></i></span> Oncology Patient Records</li>
                    <li><span class="fi"><i class="fas fa-syringe"></i></span> probe Usage &amp; Tracking</li>
                    <li><span class="fi"><i class="fas fa-wind"></i></span> Sterilization Logs</li>
                    <li><span class="fi"><i class="fas fa-flask"></i></span> Ethanol &amp; Liquid Inventory</li>
                    <li><span class="fi"><i class="fas fa-chart-line"></i></span> Procedure Reports</li>
                </ul>
            </div>

            <div class="bottom-area">
                <div class="divider-line"></div>
                <div class="med-chips">
                    <div class="med-chip"><i class="fas fa-snowflake"></i> Cryo Procedures</div>
                    <div class="med-chip"><i class="fas fa-lungs"></i> Tumor ROI</div>
                    <div class="med-chip"><i class="fas fa-boxes-stacked"></i> Inventory</div>
                    <div class="med-chip"><i class="fas fa-hospital-user"></i> Multi-Site</div>
                </div>
            </div>
        </div>

        <!-- ── Right Form Panel ── -->
        <div class="form-panel">

            <div class="form-eyebrow">Hospital Portal</div>
            <div class="form-title">Welcome Back</div>
            <div class="form-subtitle">Sign in to access your cryoablation dashboard</div>

            <form id="account" method="post">

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                <!-- Email -->
                <div class="fg">
                    <label asp-for="Input.Email">Email Address</label>
                    <div class="input-box">
                        <i class="fas fa-envelope ii"></i>
                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="doctor@hospital.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </div>

                <!-- Password -->
                <div class="fg">
                    <label asp-for="Input.Password">Password</label>
                    <div class="input-box">
                        <i class="fas fa-lock ii"></i>
                        <input asp-for="Input.Password"
                               id="passwordInput"
                               class="form-control"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="••••••••" />
                        <button class="eye-btn" type="button" onclick="togglePw()">
                            <i class="fas fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                </div>

                <!-- Remember Me -->
                <div class="form-row">
                    <label class="check-label" asp-for="Input.RememberMe">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <!-- Submit -->
                <button id="login-submit" type="submit" class="btn-submit">
                    <i class="fas fa-right-to-bracket"></i> Sign In
                </button>

            </form>

            <!-- Professional trust badges -->
            <div class="trust-row">
                <div class="trust-item"><i class="fas fa-clock"></i> 24/7 System Access</div>
                <div class="trust-item"><i class="fas fa-shield-halved"></i> Secured</div>
                <div class="trust-item"><i class="fas fa-hospital"></i> Hospital Verified</div>
            </div>

            <div class="form-footer">
                &copy; @DateTime.Now.Year SCM Co-Ablation System &mdash; All Rights Reserved
            </div>

        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

    <script>
        function togglePw() {
            var input = document.getElementById('passwordInput');
            var icon  = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
        }
    </script>

</body>
</html>
