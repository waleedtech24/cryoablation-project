@model IEnumerable<CryoablationSoftware.ViewModel.LowStockItemViewModel>

@{
    ViewData["Title"] = "Low Stock Alert";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-exclamation-triangle text-warning"></i> Low Stock Alert</h2>
                <div>
                    <button class="btn btn-warning" onclick="printReport()">
                        <i class="fas fa-print"></i> Print Report
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Summary -->
    <div class="row mb-4">
        <div class="col-md-12">
            @if (Model.Any())
            {
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> Attention Required!</h4>
                    <p>You have <strong>@Model.Count()</strong> item(s) running low on stock that need immediate attention.</p>
                    <hr>
                    <p class="mb-0">Please review and reorder these items to avoid stock-outs.</p>
                </div>
            }
            else
            {
                <div class="alert alert-success" role="alert">
                    <h4 class="alert-heading"><i class="fas fa-check-circle"></i> All Good!</h4>
                    <p class="mb-0">All items are well stocked. No action required at this time.</p>
                </div>
            }
        </div>
    </div>

    <!-- Low Stock Items -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header py-3 bg-warning">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-list"></i> Items Requiring Reorder
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="lowStockTable">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Priority</th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Current Stock</th>
                                        <th>Reorder Level</th>
                                        <th>Shortage</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var priorityOrder = Model.OrderBy(x => x.CurrentStock - x.ReorderLevel).ToList();
                                        int priority = 1;
                                    }
                                    @foreach (var item in priorityOrder)
                                    {
                                        var shortage = item.ReorderLevel - item.CurrentStock;
                                        var priorityClass = "";
                                        var priorityIcon = "";
                                        
                                        if (item.CurrentStock == 0)
                                        {
                                            priorityClass = "table-danger";
                                            priorityIcon = "fas fa-times-circle text-danger";
                                        }
                                        else if (item.CurrentStock <= (item.ReorderLevel * 0.5))
                                        {
                                            priorityClass = "table-warning";
                                            priorityIcon = "fas fa-exclamation-triangle text-warning";
                                        }
                                        else
                                        {
                                            priorityClass = "table-info";
                                            priorityIcon = "fas fa-info-circle text-info";
                                        }

                                        <tr class="@priorityClass">
                                            <td class="text-center">
                                                <i class="@priorityIcon"></i>
                                                <span class="ml-1">@priority</span>
                                            </td>
                                            <td><strong>@item.ItemCode</strong></td>
                                            <td>@item.ItemName</td>
                                            <td>
                                                @if (item.CurrentStock == 0)
                                                {
                                                    <span class="badge badge-danger">OUT OF STOCK</span>
                                                }
                                                else
                                                {
                                                    <span class="font-weight-bold">@item.CurrentStock @item.Unit</span>
                                                }
                                            </td>
                                            <td>@item.ReorderLevel @item.Unit</td>
                                            <td>
                                                @if (shortage > 0)
                                                {
                                                    <span class="text-danger font-weight-bold">@shortage @item.Unit</span>
                                                }
                                                else
                                                {
                                                    <span class="text-success">0 @item.Unit</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.CurrentStock == 0)
                                                {
                                                    <span class="badge badge-danger">CRITICAL</span>
                                                }
                                                else if (item.CurrentStock <= (item.ReorderLevel * 0.5))
                                                {
                                                    <span class="badge badge-warning">URGENT</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-info">LOW</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("ReceiveStock", new { itemId = item.ItemId })" 
                                                       class="btn btn-sm btn-success" title="Receive Stock">
                                                        <i class="fas fa-plus"></i> Reorder
                                                    </a>
                                                    <a href="@Url.Action("ItemDetails", new { id = item.ItemId })" 
                                                       class="btn btn-sm btn-outline-info" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                        priority++;
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">Quick Actions</h6>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <button class="btn btn-success btn-block" onclick="reorderAllCritical()">
                                                    <i class="fas fa-shopping-cart"></i> Reorder All Critical Items
                                                </button>
                                            </div>
                                            <div class="col-md-4">
                                                <button class="btn btn-warning btn-block" onclick="exportLowStockList()">
                                                    <i class="fas fa-file-export"></i> Export Reorder List
                                                </button>
                                            </div>
                                            <div class="col-md-4">
                                                <button class="btn btn-info btn-block" onclick="emailReport()">
                                                    <i class="fas fa-envelope"></i> Email Report
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <h4 class="text-success">Excellent Stock Management!</h4>
                            <p class="text-muted">All items are well stocked and above their reorder levels.</p>
                            <a href="@Url.Action("Items")" class="btn btn-primary">
                                <i class="fas fa-boxes"></i> View All Items
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Priority Legend -->
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h6 class="m-0 font-weight-bold text-primary">Priority Legend</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-times-circle text-danger mr-2"></i>
                                    <span class="badge badge-danger mr-2">CRITICAL</span>
                                    <span>Out of Stock - Immediate action required</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-exclamation-triangle text-warning mr-2"></i>
                                    <span class="badge badge-warning mr-2">URGENT</span>
                                    <span>Very low stock - Reorder soon</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-info-circle text-info mr-2"></i>
                                    <span class="badge badge-info mr-2">LOW</span>
                                    <span>Below reorder level - Plan reorder</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable
            $('#lowStockTable').DataTable({
                "pageLength": 25,
                "order": [[0, "asc"]], // Sort by priority
                "columnDefs": [
                    { "orderable": false, "targets": [7] } // Actions column
                ]
            });
        });

        function reorderAllCritical() {
            alert('Feature coming soon: Bulk reorder functionality will be implemented.');
        }

        function exportLowStockList() {
            // Simple CSV export
            var csv = [];
            var rows = document.querySelectorAll("#lowStockTable tr");
            
            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td, th");
                
                for (var j = 0; j < cols.length - 1; j++) { // Exclude actions column
                    var cellText = cols[j].innerText;
                    row.push('"' + cellText + '"');
                }
                csv.push(row.join(","));
            }

            var csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
            var downloadLink = document.createElement("a");
            downloadLink.download = "Low_Stock_Report_" + new Date().toISOString().slice(0,10) + ".csv";
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }

        function emailReport() {
            alert('Feature coming soon: Email reporting functionality will be implemented.');
        }

        function printReport() {
            window.print();
        }
    </script>

    <style>
        @@media print {
            .btn, .card-header, .alert {
                display: none !important;
            }
        }
    </style>
}