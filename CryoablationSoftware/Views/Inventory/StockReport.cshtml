@model IEnumerable<CryoablationSoftware.ViewModel.ItemStockReportViewModel>

@{
    ViewData["Title"] = "Stock Report";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-chart-bar"></i> Stock Report</h2>
                <div>
                    <button class="btn btn-success" onclick="exportToExcel()">
                        <i class="fas fa-file-excel"></i> Export to Excel
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Items</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-boxes fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Well Stocked</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(x => x.Status == "Normal")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Low Stock</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(x => x.Status == "Low Stock")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Total Value</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">Rs. @Model.Sum(x => x.TotalValue).ToString("N0")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Filters</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <select id="categoryFilter" class="form-control">
                                <option value="">All Categories</option>
                                @foreach (var category in Model.Select(x => x.Category).Distinct().OrderBy(x => x))
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select id="statusFilter" class="form-control">
                                <option value="">All Status</option>
                                <option value="Normal">Well Stocked</option>
                                <option value="Low Stock">Low Stock</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input type="text" id="searchFilter" class="form-control" placeholder="Search items...">
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-secondary btn-block" onclick="clearFilters()">
                                <i class="fas fa-times"></i> Clear Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Report Table -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Detailed Stock Report</h6>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="stockReportTable">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Category</th>
                                        <th>Current Stock</th>
                                        <th>Reorder Level</th>
                                        <th>Status</th>
                                        <th>Total Value</th>
                                        <th>Last Received</th>
                                        <th>Last Issued</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td><strong>@item.ItemCode</strong></td>
                                            <td>@item.ItemName</td>
                                            <td>
                                                <span class="badge badge-info">@item.Category</span>
                                            </td>
                                            <td>
                                                @if (item.Status == "Low Stock")
                                                {
                                                    <span class="text-danger font-weight-bold">@item.CurrentStock @item.Unit</span>
                                                }
                                                else
                                                {
                                                    <span class="text-success font-weight-bold">@item.CurrentStock @item.Unit</span>
                                                }
                                            </td>
                                            <td>@item.ReorderLevel @item.Unit</td>
                                            <td>
                                                @if (item.Status == "Low Stock")
                                                {
                                                    <span class="badge badge-warning">Low Stock</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">Normal</span>
                                                }
                                            </td>
                                            <td>Rs. @item.TotalValue.ToString("N0")</td>
                                            <td>
                                                @if (item.LastReceived != DateTime.MinValue)
                                                {
                                                    <small>@item.LastReceived.ToString("dd/MM/yyyy")</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Never</small>
                                                }
                                            </td>
                                            <td>
                                                @if (item.LastIssued != DateTime.MinValue)
                                                {
                                                    <small>@item.LastIssued.ToString("dd/MM/yyyy")</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Never</small>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("ItemDetails", new { id = item.ItemId })"
                                                       class="btn btn-sm btn-outline-info" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("ReceiveStock", new { itemId = item.ItemId })"
                                                       class="btn btn-sm btn-outline-success" title="Receive Stock">
                                                        <i class="fas fa-plus"></i>
                                                    </a>
                                                    <a href="@Url.Action("IssueStock", new { itemId = item.ItemId })"
                                                       class="btn btn-sm btn-outline-warning" title="Issue Stock">
                                                        <i class="fas fa-minus"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-chart-bar fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Stock Data Available</h5>
                            <p class="text-muted">Add some items to generate stock reports.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#stockReportTable').DataTable({
                "pageLength": 25,
                "order": [[1, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": [9] } // Actions column
                ]
            });

            // Custom filters
            $('#categoryFilter').on('change', function () {
                table.column(2).search(this.value).draw();
            });

            $('#statusFilter').on('change', function () {
                if (this.value === 'Normal') {
                    table.column(5).search('Normal').draw();
                } else if (this.value === 'Low Stock') {
                    table.column(5).search('Low Stock').draw();
                } else {
                    table.column(5).search('').draw();
                }
            });

            $('#searchFilter').on('keyup', function () {
                table.search(this.value).draw();
            });
        });

        function clearFilters() {
            $('#categoryFilter').val('');
            $('#statusFilter').val('');
            $('#searchFilter').val('');
            $('#stockReportTable').DataTable().search('').columns().search('').draw();
        }

        function exportToExcel() {
            // Simple CSV export functionality
            var csv = [];
            var rows = document.querySelectorAll("#stockReportTable tr");

            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td, th");

                for (var j = 0; j < cols.length - 1; j++) { // Exclude actions column
                    var cellText = cols[j].innerText;
                    row.push('"' + cellText + '"');
                }
                csv.push(row.join(","));
            }

            // Download CSV file
            var csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
            var downloadLink = document.createElement("a");
            downloadLink.download = "Stock_Report_" + new Date().toISOString().slice(0, 10) + ".csv";
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>

    <style>
        .border-left-primary {
            border-left: .25rem solid #4e73df !important;
        }

        .border-left-success {
            border-left: .25rem solid #1cc88a !important;
        }

        .border-left-info {
            border-left: .25rem solid #36b9cc !important;
        }

        .border-left-warning {
            border-left: .25rem solid #f6c23e !important;
        }

        .text-gray-800 {
            color: #5a5c69 !important;
        }

        .text-gray-300 {
            color: #dddfeb !important;
        }
    </style>
}