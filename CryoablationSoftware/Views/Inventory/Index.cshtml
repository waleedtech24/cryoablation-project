    <div class="row">
        <!-- Low Stock Alerts -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Low Stock Alerts</h6>
                    <a href="@Url.Action("LowStockReport")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (Model.LowStockAlerts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th class="text-dark">Item Name</th>
                                        <th class="text-dark">Current Stock</th>
                                        <th class="text-dark">Reorder Level</th>
                                        <th class="text-dark">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LowStockAlerts.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <strong class="text-dark">@item.ItemName</strong><br>
                                                <small class="text-muted">@item.ItemCode</small>
                                            </td>
                                            <td class="text-dark">
                                                <span class="badge bg-info text-white">@item.CurrentStock @item.Unit</span>
                                            </td>
                                            <td class="text-dark">
                                                <span class="badge bg-secondary text-white">@item.ReorderLevel @item.Unit</span>
                                            </td>
                                            <td>
                                                @if (item.CurrentStock <= 0)
                                                {
                                                    <span class="badge bg-danger text-white">Out of Stock</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <h5 class="text-success">All items are well stocked!</h5>
                            <p class="text-muted">No low stock alerts at this time.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Stock Movements -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Recent Stock Movements</h6>
                    <a href="@Url.Action("StockReport")" class="btn btn-sm btn-outline-primary">View Report</a>
                </div>
                <div class="card-body">
                    @if (Model.RecentMovements.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th class="text-dark">Date</th>
                                        <th class="text-dark">Item</th>
                                        <th class="text-dark">Type</th>
                                        <th class="text-dark">Quantity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var movement in Model.RecentMovements.Take(10))
                                    {
                                        <tr>
                                            <td class="text-dark">
                                                <small>@movement.Date.ToString("dd/MM/yyyy")</small>
                                            </td>
                                            <td>
                                                <strong class="text-dark">@movement.ItemName</strong>
                                                @if (!string.IsNullOrEmpty(movement.Reason))
                                                {
                                                    <br><small class="text-muted">@movement.Reason</small>
                                                }
                                            </td>
                                            <td>
                                                @if (movement.MovementType == "IN")
                                                {
                                                    <span class="badge bg-success text-white">
                                                        <i class="fas fa-arrow-down"></i> IN
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger text-white">
                                                        <i class="fas fa-arrow-up"></i> OUT
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-dark">
                                                <span class="badge bg-info text-white">@movement.Quantity @movement.Unit</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-history fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No recent movements</h5>
                            <p class="text-muted">Stock movements will appear here once transactions are recorded.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>


    <!-- Expiring Items Alert -->
@if (Model.ExpiringItems.Any())
{
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow border-left-warning">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        Expiring Stock Alert
                        <span class="badge bg-warning text-dark ms-2">@Model.ExpiringItems.Count</span>
                    </h6>
                    <small class="text-muted">Items expiring within 90 days</small>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover" id="expiryTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-dark">Item Name</th>
                                    <th class="text-dark">Item Code</th>
                                    <th class="text-dark">Qty in Batch</th>
                                    <th class="text-dark">Unit</th>
                                    <th class="text-dark">Expiry Date</th>
                                    <th class="text-dark">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ExpiringItems)
                                {
                                    <tr>
                                        <td><strong class="text-dark">@item.ItemName</strong></td>
                                        <td><small class="text-muted">@item.ItemCode</small></td>
                                        <td class="text-dark">@item.QuantityReceived</td>
                                        <td class="text-dark">@item.Unit</td>
                                        <td>
                                            <strong>@item.ExpiryDate.ToString("dd/MM/yyyy")</strong>
                                        </td>
                                        <td>
                                            @if (item.DaysUntilExpiry < 0)
                                            {
                                                <span class="badge bg-danger text-white">
                                                    <i class="fas fa-times-circle"></i> Expired
                                                </span>
                                            }
                                            else if (item.DaysUntilExpiry <= 30)
                                            {
                                                <span class="badge bg-danger text-white">
                                                    <i class="fas fa-fire"></i> @item.DaysUntilExpiry days left
                                                </span>
                                            }
                                            else if (item.DaysUntilExpiry <= 60)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="fas fa-exclamation"></i> @item.DaysUntilExpiry days left
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-white">
                                                    <i class="fas fa-clock"></i> @item.DaysUntilExpiry days left
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-bolt"></i> Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3 mb-3">
                            <div class="quick-action-card">
                                <a href="@Url.Action("CreateItem")" class="btn btn-outline-primary btn-lg btn-block py-4">
                                    <i class="fas fa-plus-circle fa-3x d-block mb-3 text-primary"></i>
                                    <h5 class="text-primary mb-1">Add New Item</h5>
                                    <small class="text-muted">Create new inventory item</small>
                                </a>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="quick-action-card">
                                <a href="@Url.Action("ReceiveStock")" class="btn btn-outline-success btn-lg btn-block py-4">
                                    <i class="fas fa-arrow-down fa-3x d-block mb-3 text-success"></i>
                                    <h5 class="text-success mb-1">Receive Stock</h5>
                                    <small class="text-muted">Add stock to inventory</small>
                                </a>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="quick-action-card">
                                <a asp-action="UploadExcel" style="background-color: #fff;" class="btn btn-info btn-lg btn-block py-4">
                                    <i class="fas fa-file-excel"></i>
                                    <h5 class="text-success mb-1">Upload Excel</h5>
                                  
                                </a>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="quick-action-card">
                                <a href="@Url.Action("IssueStock")" class="btn btn-outline-warning btn-lg btn-block py-4">
                                    <i class="fas fa-arrow-up fa-3x d-block mb-3 text-warning"></i>
                                    <h5 class="text-warning mb-1">Issue Stock</h5>
                                    <small class="text-muted">Remove stock from inventory</small>
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Additional Actions Row -->
                    <hr class="my-4">
                    <div class="row text-center">
                        <div class="col-md-3 mb-2">
                            <a href="@Url.Action("Items")" class="btn btn-outline-primary btn-block">
                                <i class="fas fa-boxes me-2"></i> View All Items
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="@Url.Action("LowStockReport")" class="btn btn-outline-warning btn-block">
                                <i class="fas fa-exclamation-triangle me-2"></i> Low Stock Report
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="@Url.Action("StockReport")" class="btn btn-outline-info btn-block">
                                <i class="fas fa-chart-line me-2"></i> Stock Report
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="@Url.Action("ExportItemsToExcel")" class="btn btn-outline-success btn-block">
                                <i class="fas fa-file-excel me-2"></i> Export Data
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.border-left-primary {
    border-left: .25rem solid #4e73df !important;
}
.border-left-success {
    border-left: .25rem solid #1cc88a !important;
}
.border-left-info {
    border-left: .25rem solid #36b9cc !important;
}
.border-left-warning {
    border-left: .25rem solid #f6c23e !important;
}
.border-left-danger {
    border-left: .25rem solid #e74a3b !important;
}
.border-left-secondary {
    border-left: .25rem solid #858796 !important;
}

.text-gray-800 {
    color: #5a5c69 !important;
}
.text-gray-300 {
    color: #dddfeb !important;
}

.text-dark {
    color: #212529 !important;
}

.text-white {
    color: #ffffff !important;
}

/* Badge fixes */
.bg-info {
    background-color: #17a2b8 !important;
}
.bg-success {
    background-color: #28a745 !important;
}
.bg-warning {
    background-color: #ffc107 !important;
}
.bg-danger {
    background-color: #dc3545 !important;
}
.bg-secondary {
    background-color: #6c757d !important;
}

/* Quick action cards */
.quick-action-card {
    transition: transform 0.2s ease-in-out;
}

.quick-action-card:hover {
    transform: translateY(-2px);
}

.quick-action-card .btn {
    border: 2px solid;
    transition: all 0.3s ease;
}

.quick-action-card .btn:hover {
    transform: scale(1.02);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

/* Margin utilities */
.me-2 {
    margin-right: 0.5rem !important;
}

/* Table improvements */
.table th {
    border-top: none;
    font-weight: 600;
    background-color: #f8f9fa;
}

.table-hover tbody tr:hover {
    background-color: rgba(0,0,0,.075);
}

/* Card improvements */
.card {
    border: none;
    border-radius: 0.5rem;
}

.card-header {
    background-color: #f8f9fa;
    border-bottom: 1px solid #e3e6f0;
}

/* Responsive adjustments */
@@media (max-width: 768px) {
    .col-xl-3 {
        margin-bottom: 1rem;
    }
    
    .quick-action-card .btn {
        padding: 1rem;
    }
    
    .quick-action-card i {
        font-size: 2rem !important;
    }
}
</style>
