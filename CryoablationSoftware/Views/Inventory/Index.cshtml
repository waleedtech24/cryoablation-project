                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">Liquid Nitrogen</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.LiquidNitrogen L</div>
