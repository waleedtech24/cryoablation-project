@model CryoablationSoftware.ViewModel.ItemEditViewModel



@{
    ViewData["Title"] = "Edit Item";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-edit"></i> Edit Item</h2>
                <a href="@Url.Action("Items")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Items
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Update Item Information</h6>
                </div>
                <div class="card-body">
                    <form asp-action="EditItem" method="post">
                        <input asp-for="ItemId" type="hidden" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ItemName" class="form-label">Item Name *</label>
                                    <input asp-for="ItemName" class="form-control" />
                                    <span asp-validation-for="ItemName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ItemCode" class="form-label">Item Code *</label>
                                    <input asp-for="ItemCode" class="form-control" />
                                    <span asp-validation-for="ItemCode" class="text-danger"></span>
                                    <small class="form-text text-muted">Unique identifier for the item</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="Category" class="form-label">Category *</label>
                                    <select asp-for="Category" class="form-control">
                                        <option value="">Select Category</option>
                                        @foreach (var category in ViewBag.Categories as List<string>)
                                        {
                                            <option value="@category">@category</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Category" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="ItemType" class="form-label">Item Type *</label>
                                    <select asp-for="ItemType" class="form-control">
                                        <option value="">Select Item Type</option>
                                        <option value="Probe">Probe</option>
                                        <option value="Liquid">Liquid</option>
                                        <option value="Sterile">Sterile</option>
                                    </select>
                                    <span asp-validation-for="ItemType" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Unit" class="form-label">Unit of Measurement *</label>
                                    <select asp-for="Unit" class="form-control">
                                        <option value="">Select Unit</option>
                                        @foreach (var unit in ViewBag.Units as List<string>)
                                        {
                                            <option value="@unit">@unit</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Unit" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ReorderLevel" class="form-label">Reorder Level</label>
                                    <input asp-for="ReorderLevel" class="form-control" type="number" min="0" />
                                    <span asp-validation-for="ReorderLevel" class="text-danger"></span>
                                    <small class="form-text text-muted">Minimum stock level before alert</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Status</label>
                                    <div class="form-check">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                        <label asp-for="IsActive" class="form-check-label">
                                            Item is Active
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Optional description or notes about the item"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <hr>

                        <div class="form-group d-flex justify-content-end">
                            <a href="@Url.Action("Items")" class="btn btn-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Update Item
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}