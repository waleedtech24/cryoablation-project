@model IEnumerable<CryoablationSoftware.ViewModel.ItemGroupViewModel>

@{
    ViewData["Title"] = "Probe Dashboard";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="fas fa-syringe text-primary"></i> Probe Dashboard
                </h2>
                <div>
                    <a href="@Url.Action("ReceiveStock")" class="btn btn-success">
                        <i class="fas fa-plus"></i> Receive Stock
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards — AJAX se populate honge -->
    <div class="row mb-4">

        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Probes (Ever Received)
                            </div>
                            <div class="h3 mb-0 font-weight-bold text-gray-800" id="statTotalReceived">
                                <i class="fas fa-spinner fa-spin"></i>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-database fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Used Probes
                            </div>
                            <div class="h3 mb-0 font-weight-bold text-gray-800" id="statTotalUsed">
                                <i class="fas fa-spinner fa-spin"></i>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-arrow-up fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Remaining Probes
                            </div>
                            <div class="h3 mb-0 font-weight-bold text-gray-800" id="statAvailable">
                                <i class="fas fa-spinner fa-spin"></i>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-syringe fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Probe Breakdown Table -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-table"></i> Probe Stock Breakdown
                    </h6>
                    <span class="badge bg-primary text-white px-3 py-2">
                        @ViewBag.TotalProbeTypes probe type(s)
                    </span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover mb-0" id="probeTable">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Probe Name</th>
                                        <th class="text-center">Unit</th>
                                        <th class="text-center">Total Received</th>
                                        <th class="text-center">Total Used</th>
                                        <th class="text-center">Available</th>
                                        <th class="text-center">Usage %</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Variants</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var probe in Model)
                                    {
                                        <tr data-item-name="@probe.ItemName" data-variants="@probe.TotalVariants">
                                            <td>
                                                <strong class="text-dark">@probe.ItemName</strong>
                                                @if (probe.TotalVariants > 1)
                                                {
                                                    <br>
                                                    <small class="text-muted">
                                                        <i class="fas fa-layer-group"></i> @probe.TotalVariants different codes
                                                    </small>
                                                }
                                            </td>
                                            <td class="text-center text-muted">@probe.Unit</td>

                                        
                                            <td class="text-center cell-received">
                                                <i class="fas fa-spinner fa-spin text-muted"></i>
                                            </td>
                                            <td class="text-center cell-used">
                                                <i class="fas fa-spinner fa-spin text-muted"></i>
                                            </td>
                                            <td class="text-center cell-available">
                                                <i class="fas fa-spinner fa-spin text-muted"></i>
                                            </td>
                                            <td class="text-center cell-usage" style="min-width:130px;">
                                                <i class="fas fa-spinner fa-spin text-muted"></i>
                                            </td>
                                            <td class="text-center cell-status">
                                                <span class="badge bg-secondary text-white">Loading...</span>
                                            </td>

                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-info"
                                                        onclick="showVariants('@probe.ItemName.Replace("'", "\\'")');"
                                                        title="View Variants">
                                                    <i class="fas fa-boxes"></i> View @probe.TotalVariants
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="thead-light">
                                    <tr>
                                        <td><strong>TOTAL</strong></td>
                                        <td></td>
                                        <td class="text-center" id="footReceived"><strong>-</strong></td>
                                        <td class="text-center" id="footUsed"><strong>-</strong></td>
                                        <td class="text-center" id="footAvailable"><strong>-</strong></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-syringe fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No probe items found</h5>
                            <p class="text-muted">
                                Items jinke <code>ItemType = "Probe"</code> ho woh yahaan dikhenge.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Variants Modal — same as ItemsGrouped -->
<div class="modal fade" id="variantsModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-syringe"></i> Probe Variants: <span id="modalItemName"></span>
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="variantsContent">
                    <div class="text-center py-5">
                        <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                        <p class="mt-3">Loading variants...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Totals accumulator
        var totals = { received: 0, used: 0, available: 0 };
        var completedRows = 0;
        var totalRows = 0;

        $(document).ready(function () {
            totalRows = $('tbody tr[data-item-name]').length;
            if (totalRows === 0) return;

            loadAllProbeStocks();
        });

        function loadAllProbeStocks() {
            totals = { received: 0, used: 0, available: 0 };
            completedRows = 0;

            $('tbody tr[data-item-name]').each(function () {
                var $row = $(this);
                var itemName = $row.data('item-name');

                // GetGroupedItemStock — existing endpoint, sirf available stock deta hai
                $.get('@Url.Action("GetGroupedItemStock")', { itemName: itemName })
                    .done(function (data) {
                        var available = parseInt(data.stock) || 0;

                        // Variants detail se received + used nikaalenge
                        $.get('@Url.Action("GetItemVariantsDetail")', { itemName: itemName })
                            .done(function (vData) {
                                var totalReceived = 0;
                                var totalUsed = 0;

                                if (vData.success && vData.variants) {
                                    // Har variant ka stock sum — but GetItemVariantsDetail
                                    // sirf currentStock deta hai, received/used alag nahi
                                    // Isliye: received = available + used (calculate)
                                    // Hum available use karenge aur received/used
                                    // StockRecords se seedha nahi milta yahan
                                    // So: available = jo diya GetGroupedItemStock ne
                                    // received = variants ki currentStock sum (available)
                                    // used = TotalVariants * avg? No —
                                    // Sahi approach: available hi hai jo stock hai
                                    // used = total received - available
                                    // But total received humein pata nahi AJAX se
                                    //
                                    // Simple solution jo kaam karega:
                                    // currentStock already available hai (GetGroupedItemStock)
                                    // Variants mein currentStock = available per variant
                                    // Used column ke liye hum naya endpoint nahi bana sakte
                                    // (purana code touch nahi karna)
                                    // Isliye: Used column = N/A show karenge
                                    // Ya sirf Available show karenge accurately

                                    vData.variants.forEach(function (v) {
                                        totalReceived += (v.currentStock || 0);
                                    });
                                    // Note: currentStock = available per variant
                                    // So totalReceived here = total available (same as `available`)
                                }

                                renderRow($row, available);
                            })
                            .always(function () {
                                // Fallback: sirf available se kaam chalao
                            });

                        renderRow($row, available);
                    })
                    .fail(function () {
                        $row.find('.cell-received, .cell-used, .cell-available, .cell-usage')
                            .html('<span class="text-danger">Error</span>');
                        $row.find('.cell-status')
                            .html('<span class="badge bg-secondary text-white">Error</span>');
                        completedRows++;
                        checkAllDone();
                    });
            });
        }

        function renderRow($row, available) {
            var itemName  = $row.data('item-name');
            var reorder   = parseInt($row.data('reorder')) || 0;

            // Available badge
            var availBadge, statusBadge, progressClass;
            if (available <= 0) {
                availBadge    = '<span class="badge bg-danger text-white badge-num">0</span>';
                statusBadge   = '<span class="badge bg-danger text-white">Out of Stock</span>';
                progressClass = 'bg-danger';
            } else if (available <= 2) {
                availBadge    = '<span class="badge bg-warning text-dark badge-num">' + available + '</span>';
                statusBadge   = '<span class="badge bg-warning text-dark">Low Stock</span>';
                progressClass = 'bg-warning';
            } else {
                availBadge    = '<span class="badge bg-success text-white badge-num">' + available + '</span>';
                statusBadge   = '<span class="badge bg-success text-white">In Stock</span>';
                progressClass = 'bg-success';
            }

            // Total Received column:
            // Existing endpoints sirf available dete hain.
            // GetProbeDashboardAsync waali service banane ki zarurat thi agar received chahiye thi.
            // Lekin purana code touch nahi karna — isliye:
            // "Total Received" = available (jo hame pata hai, baaki server-side)
            // "Total Used" = server se nahi milta bina naye endpoint ke
            // Is issue ko avoid karne ke liye ek dedicated AJAX endpoint banana hoga
            // jo sirf probe breakdown deta ho. Woh naya controller action hai (GET only, no view).

            $row.find('.cell-available').html(availBadge);
            $row.find('.cell-status').html(statusBadge);

            // Received aur Used: placeholder — neeche wala endpoint load karega
            $row.find('.cell-received').html('<span class="badge bg-secondary text-white badge-num loading-received" data-name="' + itemName + '">...</span>');
            $row.find('.cell-used').html('<span class="badge bg-info text-white badge-num loading-used" data-name="' + itemName + '">...</span>');

            // Usage bar: nahi pata percentage (no received data) — skip for now
            $row.find('.cell-usage').html('<span class="text-muted small">-</span>');

          //  totals.available += available;
            completedRows++;
            checkAllDone();
        }

        function checkAllDone() {
            if (completedRows >= totalRows) {
             //   updateFooterAndCards();
                // Ab received+used load karo
                loadReceivedUsed();
            }
        }

        function updateFooterAndCards() {
            $('#footAvailable').html('<strong>' + totals.available + '</strong>');
            $('#statAvailable').text(totals.available);
        }

        // Naya lightweight endpoint call — GetProbeBreakdown
        function loadReceivedUsed() {
    $.get('@Url.Action("GetProbeBreakdown")')
        .done(function (data) {
            if (!data.success) return;

            var totalReceived = 0, totalUsed = 0, totalAvailable = 0;

            data.breakdown.forEach(function (probe) {
                totalReceived  += probe.totalReceived;
                totalUsed      += probe.totalUsed;
                totalAvailable += probe.available;   // server se sahi value

                var pct = probe.totalReceived > 0
                    ? Math.round(probe.totalUsed / probe.totalReceived * 100)
                    : 0;

                var progressClass = pct >= 90 ? 'bg-danger'
                                  : pct >= 60 ? 'bg-warning'
                                  : 'bg-success';

                var $row = $('tr[data-item-name="' + probe.probeName + '"]');
                if ($row.length) {
                    $row.find('.cell-received')
                        .html('<span class="badge bg-secondary text-white badge-num">' + probe.totalReceived + '</span>');
                    $row.find('.cell-used')
                        .html('<span class="badge bg-info text-white badge-num">' + probe.totalUsed + '</span>');
                    $row.find('.cell-usage').html(
                        '<div class="d-flex align-items-center justify-content-center" style="gap:6px;">' +
                        '  <div class="progress flex-grow-1" style="height:8px;">' +
                        '    <div class="progress-bar ' + progressClass + '" style="width:' + pct + '%" role="progressbar"></div>' +
                        '  </div>' +
                        '  <small class="text-muted" style="min-width:34px;">' + pct + '%</small>' +
                        '</div>'
                    );
                }
            });

            // Footer
            $('#footReceived').html('<strong>' + totalReceived + '</strong>');
            $('#footUsed').html('<strong>' + totalUsed + '</strong>');
            $('#footAvailable').html('<strong>' + totalAvailable + '</strong>');

            // Top cards
            $('#statTotalReceived').text(totalReceived);
            $('#statTotalUsed').text(totalUsed);
            $('#statAvailable').text(totalAvailable);
        });
}

        // Variants modal — same as ItemsGrouped
        function showVariants(itemName) {
            $('#modalItemName').text(itemName);
            $('#variantsModal').modal('show');

            $('#variantsContent').html(`
                <div class="text-center py-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading variants...</p>
                </div>
            `);

            $.get('@Url.Action("GetItemVariantsDetail")', { itemName: itemName })
                .done(function (data) {
                    if (data.success && data.variants && data.variants.length > 0) {
                        var html = `
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Item Code</th>
                                            <th>Unit</th>
                                            <th>Current Stock</th>
                                            <th>Reorder Level</th>
                                            <th>Status</th>
                                            <th>Created By</th>
                                            <th>Created Date</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

                        data.variants.forEach(function (variant) {
                            var stockClass = variant.isOutOfStock ? 'text-danger fw-bold'
                                           : variant.isLowStock   ? 'text-warning fw-bold'
                                           : 'text-success fw-bold';
                            var stockBadge = variant.isOutOfStock ? '<span class="badge bg-danger ms-1">OUT</span>'
                                           : variant.isLowStock   ? '<span class="badge bg-warning text-dark ms-1">LOW</span>'
                                           : '';
                            var statusBadge = variant.isActive
                                ? '<span class="badge bg-success text-white">Active</span>'
                                : '<span class="badge bg-secondary text-white">Inactive</span>';

                            html += `
                                <tr>
                                    <td><strong>${variant.itemCode}</strong></td>
                                    <td>${variant.unit}</td>
                                    <td>
                                        <span class="${stockClass}">${variant.currentStock}</span>
                                        ${stockBadge}
                                    </td>
                                    <td>${variant.reorderLevel}</td>
                                    <td>${statusBadge}</td>
                                    <td><small>${variant.createdBy}</small></td>
                                    <td><small>${variant.createdAt}</small></td>
                                    <td>
                                        <div class="btn-group">
                                            <a href="@Url.Action("ItemDetails")?id=${variant.itemId}"
                                               class="btn btn-sm btn-info" title="View">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("EditItem")?id=${variant.itemId}"
                                               class="btn btn-sm btn-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            `;
                        });

                        html += `</tbody></table></div>`;
                        $('#variantsContent').html(html);
                    } else {
                        $('#variantsContent').html(`
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i> No variants found.
                            </div>
                        `);
                    }
                })
                .fail(function () {
                    $('#variantsContent').html(`
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle"></i> Failed to load variants.
                        </div>
                    `);
                });
        }
    </script>

    <style>
        .border-left-primary {
            border-left: .25rem solid #4e73df !important;
        }

        .border-left-success {
            border-left: .25rem solid #1cc88a !important;
        }

        .border-left-info {
            border-left: .25rem solid #36b9cc !important;
        }

        .text-gray-800 {
            color: #5a5c69 !important;
        }

        .text-gray-300 {
            color: #dddfeb !important;
        }

        .badge-num {
            font-size: 0.85rem;
            padding: 0.35em 0.7em;
            min-width: 38px;
            display: inline-block;
        }

        .thead-light th {
            background-color: #f8f9fc;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #6c757d;
            border-bottom: 2px solid #e3e6f0;
            padding: 12px 10px;
        }

        .table td {
            vertical-align: middle;
            padding: 11px 10px;
        }

        tfoot td {
            background-color: #f8f9fc;
            border-top: 2px solid #e3e6f0;
            font-size: 0.9rem;
            padding: 10px;
        }

        .progress {
            border-radius: 10px;
            background-color: #e9ecef;
        }

        .progress-bar {
            border-radius: 10px;
        }

        .bg-info {
            background-color: #17a2b8 !important;
        }

        .bg-success {
            background-color: #28a745 !important;
        }

        .bg-warning {
            background-color: #ffc107 !important;
        }

        .bg-danger {
            background-color: #dc3545 !important;
        }

        .bg-secondary {
            background-color: #6c757d !important;
        }

        .bg-primary {
            background-color: #4e73df !important;
        }

        .ms-2 {
            margin-right: 0.5rem !important;
        }

        .modal-xl {
            max-width: 1200px;
        }
    </style>
}