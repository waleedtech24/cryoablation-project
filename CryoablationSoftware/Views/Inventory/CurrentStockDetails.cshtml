@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Current Stock Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-warehouse"></i> Current Stock Details</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-success">All Items - Current Stock Status</h6>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="bg-light">
                            <tr>
                                <th>Item Name</th>
                                <th>Item Code</th>
                                <th>Category</th>
                                <th>Total Received</th>
                                <th>Total Used</th>
                                <th>Current Stock</th>
                                <th>Unit</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.ItemName</strong></td>
                                    <td>@item.ItemCode</td>
                                    <td><span class="badge bg-info">@item.Category</span></td>
                                    <td class="text-success">@item.TotalReceived</td>
                                    <td class="text-danger">@item.TotalUsed</td>
                                    <td>
                                        <strong class="@(item.CurrentStock > 0 ? "text-success" : "text-danger")">
                                            @item.CurrentStock
                                        </strong>
                                    </td>
                                    <td>@item.Unit</td>
                                    <td>
                                        @if (item.CurrentStock > 50)
                                        {
                                            <span class="badge bg-success">In Stock</span>
                                        }
                                        else if (item.CurrentStock > 0)
                                        {
                                            <span class="badge bg-warning">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light">
                            <tr>
                                <th colspan="4" class="text-end">TOTALS:</th>
                                <th class="text-danger">@Model.Sum(x => x.TotalUsed)</th>
                                <th class="text-success">@Model.Sum(x => x.CurrentStock)</th>
                                <th colspan="2"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No stock data available</h5>
                </div>
            }
        </div>
    </div>
</div>