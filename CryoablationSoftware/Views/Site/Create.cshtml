@model CryoablationSoftware.ViewModels.SiteFormViewModel
@{
    ViewData["Title"] = "Add New Site";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-plus-circle"></i> Add New Site</h2>
                <a href="@Url.Action("Index", "Site")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Sites
                </a>
            </div>

            <!-- Alerts -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-hospital"></i> Site Information
                    </h6>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="SiteName" class="form-label fw-bold">Site Name *</label>
                                <input asp-for="SiteName" class="form-control" placeholder="e.g., Mayo Hospital Lahore" />
                                <span asp-validation-for="SiteName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SiteCity" class="form-label">City</label>
                                <input asp-for="SiteCity" class="form-control" placeholder="e.g., Lahore" />
                                <span asp-validation-for="SiteCity" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="SitePhone" class="form-label">Phone</label>
                                <input asp-for="SitePhone" class="form-control" placeholder="e.g., 042-1234567" />
                                <span asp-validation-for="SitePhone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="SiteAddress" class="form-label">Address</label>
                                <input asp-for="SiteAddress" class="form-control" placeholder="Full address" />
                                <span asp-validation-for="SiteAddress" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="SiteEmail" class="form-label">Email</label>
                                <input asp-for="SiteEmail" class="form-control" type="email" placeholder="e.g., info@hospital.com" />
                                <span asp-validation-for="SiteEmail" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="SiteDescription" class="form-label">Description</label>
                                <textarea asp-for="SiteDescription" class="form-control" rows="3"
                                          placeholder="Optional notes about this site"></textarea>
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-end gap-2">
                            <a href="@Url.Action("Index", "Site")" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Site
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
