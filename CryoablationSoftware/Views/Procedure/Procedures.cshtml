@model IEnumerable<CryoablationSoftware.ViewModel.ProcedureListViewModel>

@{
    ViewData["Title"] = "All Procedures";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-procedures"></i> All Procedures</h2>
                <div>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fas fa-plus"></i> New Procedure
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="close" data-dismiss="alert">
                        <span>&times;</span>
                    </button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="close" data-dismiss="alert">
                        <span>&times;</span>
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <select id="statusFilter" class="form-control">
                                <option value="">All Statuses</option>
                                <option value="Scheduled">Scheduled</option>
                                <option value="In-Progress">In-Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input type="date" id="dateFromFilter" class="form-control" placeholder="From Date">
                        </div>
                        <div class="col-md-3">
                            <input type="date" id="dateToFilter" class="form-control" placeholder="To Date">
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-secondary btn-block" onclick="clearFilters()">
                                <i class="fas fa-times"></i> Clear Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Procedures Table -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Procedures List (@Model.Count() total)</h6>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="proceduresTable">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Patient</th>
                                        <th>MR#</th>
                                        <th>ROI</th>
                                        <th>Duration</th>
                                        <th>Status</th>
                                        <th>Items</th>
                                        <th>Created By</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var procedure in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@procedure.ProcedureDate.ToString("yyyy-MM-dd")</strong><br>
                                                <small class="text-muted">@procedure.ProcedureDate.ToString("dd/MM/yyyy")</small>
                                            </td>
                                            <td>
                                                <strong>@procedure.PatientName</strong>
                                            </td>
                                            <td>@procedure.PatientMRNumber</td>
                                            <td>@procedure.ProcedureROI</td>
                                            <td>@procedure.ProcedureDuration</td>
                                            <td>
                                                <!-- Status Select Dropdown -->
                                                <select class="form-control form-control-sm status-select"
                                                        data-procedure-id="@procedure.ProcedureId"
                                                        data-patient-name="@procedure.PatientName"
                                                        data-current-status="@procedure.ProcedureStatus"
                                                        style="min-width: 120px;">
                                                    @{
                                                        var isScheduled = procedure.ProcedureStatus == "Scheduled";
                                                        var isInProgress = procedure.ProcedureStatus == "In-Progress";
                                                        var isCompleted = procedure.ProcedureStatus == "Completed";
                                                        var isCancelled = procedure.ProcedureStatus == "Cancelled";
                                                    }
                                                    <option value="Scheduled" selected="@isScheduled">Scheduled</option>
                                                    <option value="In-Progress" selected="@isInProgress">In-Progress</option>
                                                    <option value="Completed" selected="@isCompleted">Completed</option>
                                                    <option value="Cancelled" selected="@isCancelled">Cancelled</option>
                                                </select>
                                                <!-- Status Badge for Visual Reference -->
                                                <div class="mt-1">
                                                    @switch (procedure.ProcedureStatus)
                                                    {
                                                        case "Scheduled":
                                                            <span class="badge bg-warning text-dark">@procedure.ProcedureStatus</span>
                                                            break;
                                                        case "In-Progress":
                                                            <span class="badge bg-info text-white">@procedure.ProcedureStatus</span>
                                                            break;
                                                        case "Completed":
                                                            <span class="badge bg-success text-white">@procedure.ProcedureStatus</span>
                                                            break;
                                                        case "Cancelled":
                                                            <span class="badge bg-danger text-white">@procedure.ProcedureStatus</span>
                                                            break;
                                                        default:
                                                            <span class="badge bg-secondary text-white">@procedure.ProcedureStatus</span>
                                                            break;
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex justify-content-between">
                                                    <span class="badge bg-primary text-white">A: @procedure.TotalItemsAssigned</span>
                                                    <span class="badge bg-success text-white">U: @procedure.TotalItemsUsed</span>
                                                </div>
                                                <small class="text-dark">Assigned / Used</small>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @procedure.PrimaryDoctorName<br>
                                                    @procedure.CreatedAt.ToString("dd/MM/yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Details", new { id = procedure.ProcedureId })"
                                                       class="btn btn-sm btn-outline-info" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("Edit", new { id = procedure.ProcedureId })"
                                                       class="btn btn-sm btn-outline-primary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>

                                                    @if (procedure.ProcedureStatus == "Scheduled")
                                                    {
                                                        <a href="@Url.Action("RecordUsage", new { procedureId = procedure.ProcedureId })"
                                                           class="btn btn-sm btn-outline-warning" title="Record Item Usage">
                                                            <i class="fas fa-clipboard-list"></i>
                                                        </a>
                                                    }




                                                    <a href="@Url.Action("AssignItems", "Procedure", new { id = procedure.ProcedureId })"
                                                       class="btn btn-sm btn-outline-success"
                                                       title="Assign Items to Procedure">
                                                        <i class="fas fa-plus-square"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            onclick="confirmDelete('@procedure.ProcedureId', '@procedure.PatientName', '@procedure.ProcedureROI')"
                                                            title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-procedures fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Procedures Found</h5>
                            <p class="text-muted">Start by scheduling your first procedure.</p>
                            <a href="@Url.Action("Create")" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Schedule First Procedure
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    @if (Model.Any())
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h6 class="m-0 font-weight-bold text-primary">Quick Statistics</h6>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <div class="border-right">
                                    <h4 class="text-warning">@Model.Count(p => p.ProcedureStatus == "Scheduled")</h4>
                                    <span class="text-muted">Scheduled</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border-right">
                                    <h4 class="text-info">@Model.Count(p => p.ProcedureStatus == "In-Progress")</h4>
                                    <span class="text-muted">In Progress</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border-right">
                                    <h4 class="text-success">@Model.Count(p => p.ProcedureStatus == "Completed")</h4>
                                    <span class="text-muted">Completed</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <h4 class="text-danger">@Model.Count(p => p.ProcedureStatus == "Cancelled")</h4>
                                <span class="text-muted">Cancelled</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this procedure?</p>
                <div class="alert alert-info">
                    <strong>Patient:</strong> <span id="deletePatientName"></span><br>
                    <strong>ROI:</strong> <span id="deleteProcedureROI"></span>
                </div>
                <p class="text-warning"><i class="fas fa-exclamation-triangle"></i> This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <form method="post" style="display: inline;" id="deleteForm">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete Procedure</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Status Change Confirmation Modal -->
<div class="modal fade" id="statusChangeModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Status Change</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to change the procedure status?</p>
                <div class="alert alert-info">
                    <strong>Patient:</strong> <span id="statusChangePatientName"></span><br>
                    <strong>Current Status:</strong> <span id="currentStatus"></span><br>
                    <strong>New Status:</strong> <span id="newStatus"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmStatusChange">Confirm Change</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS and JS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap4.min.css">
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function () {
            // Check if DataTable function exists
            if (typeof $.fn.DataTable === 'function') {
                // Initialize DataTable
                var table = $('#proceduresTable').DataTable({
                    "pageLength": 25,
                    "order": [[0, "desc"]], // Sort by date descending
                    "columnDefs": [
                        { "orderable": false, "targets": [8] } // Actions column
                    ]
                });

                // Custom filters
                $('#statusFilter').on('change', function () {
                    table.column(5).search(this.value).draw();
                });

                $('#dateFromFilter, #dateToFilter').on('change', function () {
                    table.draw();
                });

                // Custom date range filter
                $.fn.dataTable.ext.search.push(
                    function (settings, data, dataIndex) {
                        var dateFrom = $('#dateFromFilter').val();
                        var dateTo = $('#dateToFilter').val();

                        if (!dateFrom && !dateTo) return true;

                        var dateStr = data[0]; // Date column
                        var procedureDate = new Date(dateStr.split('<br>')[0].replace(/(\d{2})\/(\d{2})\/(\d{4})/, '$3-$2-$1'));

                        var min = dateFrom ? new Date(dateFrom) : null;
                        var max = dateTo ? new Date(dateTo) : null;

                        if ((min === null || procedureDate >= min) && (max === null || procedureDate <= max)) {
                            return true;
                        }
                        return false;
                    }
                );
            } else {
                console.log('DataTables library not loaded. Table will work without advanced features.');
            }

            // Status change functionality
            let selectedProcedureId = '';
            let selectedNewStatus = '';
            let selectedPatientName = '';
            let selectedCurrentStatus = '';

            $('.status-select').on('change', function () {
                var currentStatus = $(this).data('current-status');
                var newStatus = $(this).val();

                // Don't show modal if same status
                if (currentStatus === newStatus) {
                    return;
                }

                selectedProcedureId = $(this).data('procedure-id');
                selectedNewStatus = newStatus;
                selectedPatientName = $(this).data('patient-name');
                selectedCurrentStatus = currentStatus;

                $('#statusChangePatientName').text(selectedPatientName);
                $('#currentStatus').text(selectedCurrentStatus);
                $('#newStatus').text(selectedNewStatus);
                $('#statusChangeModal').modal('show');
            });

            $('#confirmStatusChange').on('click', function () {
                updateProcedureStatus(selectedProcedureId, selectedNewStatus);
            });
        });

        function clearFilters() {
            $('#statusFilter').val('');
            $('#dateFromFilter').val('');
            $('#dateToFilter').val('');

            // Check if DataTable exists before using it
            if ($.fn.DataTable.isDataTable('#proceduresTable')) {
                $('#proceduresTable').DataTable().search('').columns().search('').draw();
            }
        }

        function confirmDelete(procedureId, patientName, procedureROI) {
            $('#deletePatientName').text(patientName);
            $('#deleteProcedureROI').text(procedureROI);
            $('#deleteForm').attr('action', '@Url.Action("Delete")/' + procedureId);
            $('#deleteModal').modal('show');
        }

        function updateProcedureStatus(procedureId, newStatus) {
            // Show loading state
            $('#confirmStatusChange').prop('disabled', true).text('Updating...');

            $.ajax({
                url: '@Url.Action("UpdateStatus")',
                type: 'POST',
                data: {
                    procedureId: procedureId,
                    newStatus: newStatus,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    $('#confirmStatusChange').prop('disabled', false).text('Confirm Change');

                    if (response.success) {
                        $('#statusChangeModal').modal('hide');

                        // Show success message
                        var successAlert = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                            '<i class="fas fa-check-circle"></i> ' + (response.message || 'Status updated successfully') +
                            '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>' +
                            '</div>';
                        $('.container-fluid .row:first-child .col-md-12').append(successAlert);

                        // Refresh page after 1 second
                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    } else {
                        alert('Error: ' + (response.message || 'Unknown error occurred'));
                    }
                },
                error: function (xhr, status, error) {
                    $('#confirmStatusChange').prop('disabled', false).text('Confirm Change');
                    console.error('AJAX Error:', error);
                    alert('Error updating procedure status. Please try again.');
                }
            });
        }
    </script>

    <style>
        .status-select {
            border: 2px solid #dee2e6;
            border-radius: 6px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .status-select:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
            }

            .status-select option {
                color: #000 !important;
                background-color: #fff !important;
                padding: 8px;
            }

        .badge {
            font-size: 0.75em;
            font-weight: 600;
        }

        .bg-warning {
            background-color: #ffc107 !important;
        }

        .bg-info {
            background-color: #0dcaf0 !important;
        }

        .bg-success {
            background-color: #198754 !important;
        }

        .bg-danger {
            background-color: #dc3545 !important;
        }

        .bg-primary {
            background-color: #0d6efd !important;
        }

        .bg-secondary {
            background-color: #6c757d !important;
        }

        .text-white {
            color: #ffffff !important;
        }

        .text-dark {
            color: #212529 !important;
        }

        .me-2 {
            margin-right: 0.5rem;
        }

        .dropdown-item:hover {
            background-color: #f8f9fa;
        }

        .table td {
            vertical-align: middle;
        }

        .form-control-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
            border-radius: 0.2rem;
        }
    </style>
}