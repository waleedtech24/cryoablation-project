@model CryoablationSoftware.ViewModel.Reporting.ReportGenerationViewModel
@{
    ViewData["Title"] = "Generate Report";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .generation-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
        }

        .form-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
            border: 1px solid #f1f3f4;
        }

        .section-title {
            color: #2c3e50;
            font-weight: 600;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #f8f9fa;
        }

        .form-group label {
            font-weight: 500;
            color: #495057;
            margin-bottom: 8px;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #dee2e6;
            padding: 10px 15px;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
        }

        .checkbox-group {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            margin: 10px 0;
        }

        .checkbox-group label {
            font-weight: normal;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
        }

        .checkbox-group input[type="checkbox"] {
            margin-right: 10px;
        }

        .generate-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 15px 30px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            width: 100%;
        }

        .generate-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            color: white;
        }

        .preview-btn {
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
            border: none;
            color: white;
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
            width: 100%;
        }

        .preview-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            color: white;
        }

        .advanced-options {
            background: #f8f9fa;
            border: 1px dashed #dee2e6;
            border-radius: 10px;
            padding: 20px;
            margin-top: 15px;
        }

        .selection-container {
            max-height: 200px;
            overflow-y: auto;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 10px;
            background: white;
        }

        .selection-item {
            padding: 5px 10px;
            border-radius: 5px;
            margin-bottom: 5px;
            transition: background-color 0.2s;
        }

        .selection-item:hover {
            background-color: #f8f9fa;
        }

        .selection-item input {
            margin-right: 8px;
        }

        .format-option {
            text-align: center;
            padding: 20px 15px;
            border: 2px solid #dee2e6;
            border-radius: 10px;
            margin-bottom: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .format-option:hover {
            border-color: #667eea;
            background-color: #f8f9fa;
        }

        .format-option.selected {
            border-color: #667eea;
            background-color: #e3f2fd;
        }

        .format-icon {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .date-preset-btn {
            padding: 5px 12px;
            font-size: 0.875rem;
            margin-right: 5px;
            margin-bottom: 5px;
        }

        .validation-error {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 5px;
        }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            z-index: 9999;
        }

        .loading-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 30px;
            border-radius: 10px;
            text-align: center;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #667eea;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
}

<div class="generation-header">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="mb-2"><i class="fas fa-file-alt"></i> Generate Report</h1>
            <p class="mb-0">Create professional reports with customizable parameters and export options</p>
        </div>
        <div class="col-md-4 text-right">
            <a href="@Url.Action("Index")" class="btn btn-outline-light">
                <i class="fas fa-arrow-left"></i> Back to Reports
            </a>
        </div>
    </div>
</div>
@if (ViewData.ModelState != null && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}
<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="loading-content">
        <div class="spinner"></div>
        <h5>Generating Report...</h5>
        <p class="text-muted">Please wait while we prepare your report</p>
    </div>
</div>

<form asp-action="Generate" method="post" id="reportForm">
    <div class="row">
        <div class="col-lg-8">
            <!-- Report Basic Information -->
            <div class="form-section">
                <h4 class="section-title">
                    <i class="fas fa-file-alt text-primary"></i> Report Information
                </h4>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ReportTitle">Report Title *</label>
                            <input asp-for="ReportTitle" class="form-control" placeholder="Enter report title" required />
                            <span asp-validation-for="ReportTitle" class="validation-error"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ReportType">Report Type *</label>
                            <select asp-for="ReportType" class="form-control" required onchange="updateReportOptions()">
                                <option value="">Select Report Type</option>
                                <option value="PatientProcedure">Patient Procedure Report</option>
                                <option value="InventoryConsumption">Inventory Consumption Report</option>
                                <option value="FinancialSummary">Financial Summary Report</option>
                                <option value="StockMovement">Stock Movement Report</option>
                                <option value="ProcedureAnalysis">Procedure Analysis Report</option>
                                <option value="LowStockAlert">Low Stock Alert Report</option>
                                <option value="ItemValuation">Item Valuation Report</option>
                            </select>
                            <span asp-validation-for="ReportType" class="validation-error"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Date Range -->
            <div class="form-section">
                <h4 class="section-title">
                    <i class="fas fa-calendar text-info"></i> Date Range
                </h4>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="FromDate">From Date</label>
                            <input asp-for="FromDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ToDate">To Date</label>
                            <input asp-for="ToDate" type="date" class="form-control" />
                        </div>
                    </div>
                </div>
                
                <div class="row mt-2">
                    <div class="col-12">
                        <label class="mb-2">Quick Date Presets:</label>
                        <div>
                            <button type="button" class="btn btn-outline-secondary btn-sm date-preset-btn" onclick="setDateRange('today', event)">Today</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm date-preset-btn" onclick="setDateRange('week', event)">This Week</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm date-preset-btn" onclick="setDateRange('month', event)">This Month</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm date-preset-btn" onclick="setDateRange('quarter', event)">This Quarter</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm date-preset-btn" onclick="setDateRange('year', event)">This Year</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filters & Selection -->
            <div class="form-section" id="selectionSection">
                <h4 class="section-title">
                    <i class="fas fa-filter text-warning"></i> Filters & Selection
                </h4>

                <!-- Patient Selection -->
                <div id="patientSelection" style="display: none;">
                    <div class="form-group">
                        <label>Patient Selection</label>
                        <div class="form-check mb-2">
                            <input asp-for="IncludeAllPatients" class="form-check-input" type="checkbox" checked onchange="togglePatientList()" />
                            <label asp-for="IncludeAllPatients" class="form-check-label">Include All Patients</label>
                        </div>
                        
                        <div id="patientList" class="selection-container" style="display: none;">
                            <div class="text-center text-muted">
                                <i class="fas fa-spinner fa-spin"></i> Loading patients...
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Item/Category Selection -->
                <div id="itemSelection" style="display: none;">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Category Selection</label>
                                <div class="form-check mb-2">
                                    <input type="checkbox" class="form-check-input" id="includeAllCategories" checked onchange="toggleCategoryList()" />
                                    <label class="form-check-label" for="includeAllCategories">Include All Categories</label>
                                </div>
                                <div id="categoryList" class="selection-container" style="display: none;">
                                    <div class="text-center text-muted">
                                        <i class="fas fa-spinner fa-spin"></i> Loading categories...
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Item Selection</label>
                                <div class="form-check mb-2">
                                    <input asp-for="IncludeAllItems" class="form-check-input" type="checkbox" checked onchange="toggleItemList()" />
                                    <label asp-for="IncludeAllItems" class="form-check-label">Include All Items</label>
                                </div>
                                <div id="itemList" class="selection-container" style="display: none;">
                                    <div class="text-center text-muted">
                                        <i class="fas fa-spinner fa-spin"></i> Loading items...
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Filter -->
                <div class="form-group">
                    <label asp-for="StatusFilter">Status Filter</label>
                    <select asp-for="StatusFilter" class="form-control">
                        <option value="">All Statuses</option>
                        <option value="Completed">Completed</option>
                        <option value="Scheduled">Scheduled</option>
                        <option value="In-Progress">In-Progress</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <!-- Value Range Filter -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MinValue">Minimum Value (Rs)</label>
                            <input asp-for="MinValue" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MaxValue">Maximum Value (Rs)</label>
                            <input asp-for="MaxValue" type="number" step="0.01" class="form-control" placeholder="No limit" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Report Options -->
            <div class="form-section">
                <h4 class="section-title">
                    <i class="fas fa-cog text-success"></i> Report Options
                </h4>

                <div class="checkbox-group">
                    <label>
                        <input asp-for="IncludeSummary" type="checkbox" checked />
                        Include Executive Summary
                    </label>
                    <label>
                        <input asp-for="IncludeCharts" type="checkbox" checked />
                        Include Charts and Graphs
                    </label>
                    <label>
                        <input asp-for="IncludeDetailedData" type="checkbox" checked />
                        Include Detailed Data Tables
                    </label>
                    <label>
                        <input asp-for="IncludeRecommendations" type="checkbox" />
                        Include Recommendations and Insights
                    </label>
                </div>

                <div class="advanced-options">
                    <h6><i class="fas fa-cogs"></i> Advanced Options</h6>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="GroupBy">Group By</label>
                                <select asp-for="GroupBy" class="form-control">
                                    <option value="">No Grouping</option>
                                    <option value="Date">Date</option>
                                    <option value="Category">Category</option>
                                    <option value="Patient">Patient</option>
                                    <option value="Status">Status</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SortBy">Sort By</label>
                                <select asp-for="SortBy" class="form-control">
                                    <option value="Date">Date</option>
                                    <option value="Name">Name</option>
                                    <option value="Value">Value</option>
                                    <option value="Quantity">Quantity</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SortOrder">Sort Order</label>
                                <select asp-for="SortOrder" class="form-control">
                                    <option value="DESC">Descending</option>
                                    <option value="ASC">Ascending</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Sidebar -->
        <div class="col-lg-4">
            <!-- Output Format -->
            <div class="form-section">
                <h4 class="section-title">
                    <i class="fas fa-download text-primary"></i> Output Format
                </h4>

                <div class="format-option" onclick="selectFormat('PDF')">
                    <div class="format-icon text-danger">
                        <i class="fas fa-file-pdf"></i>
                    </div>
                    <h6>PDF Document</h6>
                    <small>Professional format with charts</small>
                    <input type="radio" name="OutputFormat" value="PDF" class="d-none" checked />
                </div>

                <div class="format-option" onclick="selectFormat('Excel')">
                    <div class="format-icon text-success">
                        <i class="fas fa-file-excel"></i>
                    </div>
                    <h6>Excel Spreadsheet</h6>
                    <small>Data analysis and calculations</small>
                    <input type="radio" name="OutputFormat" value="Excel" class="d-none" />
                </div>

                <div class="format-option" onclick="selectFormat('View')">
                    <div class="format-icon text-info">
                        <i class="fas fa-eye"></i>
                    </div>
                    <h6>View in Browser</h6>
                    <small>Preview before downloading</small>
                    <input type="radio" name="OutputFormat" value="View" class="d-none" />
                </div>
            </div>

            <!-- Page Settings -->
            <div class="form-section">
                <h4 class="section-title">
                    <i class="fas fa-file text-secondary"></i> Page Settings
                </h4>

                <div class="form-group">
                    <label asp-for="PageSize">Page Size</label>
                    <select asp-for="PageSize" class="form-control">
                        <option value="A4" selected>A4 (210 × 297 mm)</option>
                        <option value="A3">A3 (297 × 420 mm)</option>
                        <option value="Letter">Letter (216 × 279 mm)</option>
                        <option value="Legal">Legal (216 × 356 mm)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Orientation">Orientation</label>
                    <select asp-for="Orientation" class="form-control">
                        <option value="Portrait" selected>Portrait</option>
                        <option value="Landscape">Landscape</option>
                    </select>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="form-section">
                <div class="d-grid gap-3">
                    <button type="submit" class="generate-btn" id="generateBtn">
                        <i class="fas fa-file-download"></i> Generate & Download Report
                    </button>
                    
                    <button type="button" class="preview-btn" onclick="previewReport()">
                        <i class="fas fa-eye"></i> Preview Report
                    </button>
                    
                    <button type="button" class="btn btn-outline-secondary" onclick="saveTemplate()" style="width: 100%;">
                        <i class="fas fa-save"></i> Save as Template
                    </button>
                    
                    <button type="reset" class="btn btn-outline-warning" onclick="resetForm()" style="width: 100%;">
                        <i class="fas fa-undo"></i> Reset Form
                    </button>
                </div>

                <div class="mt-3 text-center">
                    <small class="text-muted">
                        <i class="fas fa-info-circle"></i>
                        Report generation may take 30-60 seconds for large datasets
                    </small>
                </div>
            </div>

            <!-- Report Preview -->
            <div class="form-section" style="display: none;" id="previewSection">
                <h4 class="section-title">
                    <i class="fas fa-search text-info"></i> Report Preview
                </h4>
                <div id="previewContent">
                    <!-- Preview content will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            initializeForm();
        });

        function initializeForm() {
            // Initialize form based on query parameter
            const urlParams = new URLSearchParams(window.location.search);
            const reportType = urlParams.get('reportType');

            if (reportType) {
                $('#ReportType').val(reportType);
                updateReportOptions();
            }

            // Load dropdown data
            loadPatients();
            loadItems();
            loadCategories();

            // Set default dates - pass null as event since it's initialization
            setDateRange('month', null);

            // Initialize format selection
            selectFormat('PDF');
        }

        function updateReportOptions() {
            const reportType = $('#ReportType').val();

            // Hide all selection sections first
            $('#patientSelection, #itemSelection').hide();

            // Show relevant sections based on report type
            switch (reportType) {
                case 'PatientProcedure':
                case 'ProcedureAnalysis':
                    $('#patientSelection').show();
                    break;
                case 'InventoryConsumption':
                case 'StockMovement':
                case 'ItemValuation':
                    $('#itemSelection').show();
                    break;
            }

            // Update report title if empty
            if (!$('#ReportTitle').val() && reportType) {
                const titles = {
                    'PatientProcedure': 'Patient Procedure Report',
                    'InventoryConsumption': 'Inventory Consumption Report',
                    'FinancialSummary': 'Financial Summary Report',
                    'StockMovement': 'Stock Movement Report',
                    'ProcedureAnalysis': 'Procedure Analysis Report',
                    'LowStockAlert': 'Low Stock Alert Report',
                    'ItemValuation': 'Item Valuation Report'
                };
                $('#ReportTitle').val(titles[reportType] || 'Custom Report');
            }
        }

        // Fixed function to accept event parameter
        function setDateRange(period, event) {
            const today = new Date();
            let fromDate, toDate = today;

            switch (period) {
                case 'today':
                    fromDate = today;
                    break;
                case 'week':
                    fromDate = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
                    break;
                case 'month':
                    fromDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    break;
                case 'quarter':
                    const quarterStartMonth = Math.floor(today.getMonth() / 3) * 3;
                    fromDate = new Date(today.getFullYear(), quarterStartMonth, 1);
                    break;
                case 'year':
                    fromDate = new Date(today.getFullYear(), 0, 1);
                    break;
            }

            $('#FromDate').val(formatDate(fromDate));
            $('#ToDate').val(formatDate(toDate));

            // Highlight selected preset button - only if event is provided
            if (event && event.target) {
                $('.date-preset-btn').removeClass('btn-primary').addClass('btn-outline-secondary');
                $(event.target).removeClass('btn-outline-secondary').addClass('btn-primary');
            }
        }

        function formatDate(date) {
            return date.toISOString().split('T')[0];
        }

        function selectFormat(format) {
            $('.format-option').removeClass('selected');
            $('.format-option').each(function () {
                if ($(this).find('input').val() === format) {
                    $(this).addClass('selected');
                    $(this).find('input').prop('checked', true);
                }
            });
        }

        function togglePatientList() {
            const includeAll = $('#IncludeAllPatients').is(':checked');
            $('#patientList').toggle(!includeAll);
        }

        function toggleItemList() {
            const includeAll = $('#IncludeAllItems').is(':checked');
            $('#itemList').toggle(!includeAll);
        }

        function toggleCategoryList() {
            const includeAll = $('#includeAllCategories').is(':checked');
            $('#categoryList').toggle(!includeAll);
        }

        function loadPatients() {
            $.get('@Url.Action("GetPatientsForReport")')
                .done(function (data) {
                    let html = '';
                    if (data && data.length > 0) {
                        data.forEach(function (patient) {
                            html += `
                                <div class="selection-item">
                                    <input type="checkbox" name="SelectedPatients" value="${patient.patientId}" />
                                    <label>${patient.patientName} (${patient.patientMRNumber})</label>
                                </div>`;
                        });
                    } else {
                        html = '<div class="text-center text-muted">No patients found</div>';
                    }
                    $('#patientList').html(html);
                })
                .fail(function () {
                    $('#patientList').html('<div class="text-center text-danger">Error loading patients</div>');
                });
        }

        function loadItems() {
            $.get('@Url.Action("GetItemsForReport")')
                .done(function (data) {
                    let html = '';
                    if (data && data.length > 0) {
                        data.forEach(function (item) {
                            html += `
                                <div class="selection-item">
                                    <input type="checkbox" name="SelectedItems" value="${item.itemId}" />
                                    <label>${item.itemName} (${item.itemCode})</label>
                                </div>`;
                        });
                    } else {
                        html = '<div class="text-center text-muted">No items found</div>';
                    }
                    $('#itemList').html(html);
                })
                .fail(function () {
                    $('#itemList').html('<div class="text-center text-danger">Error loading items</div>');
                });
        }

        function loadCategories() {
            $.get('@Url.Action("GetCategoriesForReport")')
                .done(function (data) {
                    let html = '';
                    if (data && data.length > 0) {
                        data.forEach(function (category) {
                            html += `
                                <div class="selection-item">
                                    <input type="checkbox" name="SelectedCategories" value="${category}" />
                                    <label>${category}</label>
                                </div>`;
                        });
                    } else {
                        html = '<div class="text-center text-muted">No categories found</div>';
                    }
                    $('#categoryList').html(html);
                })
                .fail(function () {
                    $('#categoryList').html('<div class="text-center text-danger">Error loading categories</div>');
                });
        }

        function previewReport() {
            if (!validateForm()) return;

            $('#previewSection').show();
            $('#previewContent').html('<div class="text-center"><i class="fas fa-spinner fa-spin"></i> Generating preview...</div>');

            setTimeout(function () {
                const reportTitle = $('#ReportTitle').val();
                const reportType = $('#ReportType option:selected').text();
                const fromDate = $('#FromDate').val();
                const toDate = $('#ToDate').val();
                const outputFormat = $('.format-option.selected h6').text();

                $('#previewContent').html(`
                    <div class="card">
                        <div class="card-body">
                            <h5><i class="fas fa-eye text-info"></i> Report Preview</h5>
                            <hr>
                            <div class="row mb-2">
                                <div class="col-sm-4"><strong>Title:</strong></div>
                                <div class="col-sm-8">${reportTitle}</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4"><strong>Type:</strong></div>
                                <div class="col-sm-8">${reportType}</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4"><strong>Date Range:</strong></div>
                                <div class="col-sm-8">${fromDate || 'Not specified'} to ${toDate || 'Not specified'}</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4"><strong>Format:</strong></div>
                                <div class="col-sm-8">${outputFormat}</div>
                            </div>
                            <hr>
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i>
                                This is a preview. Click "Generate & Download Report" to create the full report.
                            </div>
                        </div>
                    </div>
                `);
            }, 1500);
        }

        function saveTemplate() {
            if (!validateForm()) return;

            const templateName = prompt('Enter template name:');
            if (templateName) {
                alert(`Template "${templateName}" will be saved in the next version.`);
            }
        }

        function resetForm() {
            if (confirm('Are you sure you want to reset the form? All entered data will be lost.')) {
                document.getElementById('reportForm').reset();
                $('#previewSection').hide();
                $('.format-option').removeClass('selected');
                selectFormat('PDF');
                setDateRange('month', null);
            }
        }

        function validateForm() {
            let isValid = true;
            $('.form-control').removeClass('is-invalid');

            if (!$('#ReportTitle').val()) {
                $('#ReportTitle').addClass('is-invalid');
                isValid = false;
            }

            if (!$('#ReportType').val()) {
                $('#ReportType').addClass('is-invalid');
                isValid = false;
            }

            const fromDate = $('#FromDate').val();
            const toDate = $('#ToDate').val();
            if (fromDate && toDate && new Date(fromDate) > new Date(toDate)) {
                $('#FromDate, #ToDate').addClass('is-invalid');
                alert('From date cannot be greater than To date');
                isValid = false;
            }

            if (!isValid) {
                $('html, body').animate({
                    scrollTop: $('.is-invalid').first().offset().top - 100
                }, 500);
            }

            return isValid;
        }

        // Form submission handling
        $('#reportForm').on('submit', function (e) {
            if (!validateForm()) {
                e.preventDefault();
                return false;
            }

            // Show loading overlay
            $('#loadingOverlay').show();
            $('#generateBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Generating...');

            // Let form submit normally
            return true;
        });

        // Hide loading on page unload (in case of errors)
        $(window).on('beforeunload', function () {
            $('#loadingOverlay').hide();
            $('#generateBtn').prop('disabled', false).html('<i class="fas fa-file-download"></i> Generate & Download Report');
        });
    </script>
}