@* Views/SuperAdmin/ConsolidatedReports.cshtml *@
@model CryoablationSoftware.ViewModel.ConsolidatedReportsViewModel
@{
    ViewData["Title"] = "Consolidated Reports";
    var siteColors = new[] { "#4f86f7", "#28a745", "#ffc107", "#17a2b8", "#f093fb", "#fa709a", "#fd7e14", "#20c997" };
    string Col(int i) => siteColors[i % siteColors.Length];
}

@section Styles {
    <style>
        .page-banner {
            background: linear-gradient(135deg,rgba(79,134,247,.95),rgba(58,117,245,.9));
            color: white;
            padding: 22px 28px 50px;
            margin: -32px -12px 0;
            border-radius: 0 0 20px 20px;
        }

        .stat-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            padding: 20px;
            margin-top: -28px;
            transition: transform .2s;
        }

            .stat-card:hover {
                transform: translateY(-3px);
            }

        .section-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            padding: 20px;
            margin-bottom: 20px;
        }

            .section-card h5 {
                font-size: .95rem;
                font-weight: 700;
                color: #333;
                margin-bottom: 16px;
            }

                .section-card h5 i {
                    color: #4f86f7;
                }

        .report-btn {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 18px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
            margin-bottom: 12px;
            text-decoration: none;
            color: #333;
            border: 1px solid transparent;
            transition: all .2s;
        }

            .report-btn:hover {
                border-color: #4f86f7;
                box-shadow: 0 4px 16px rgba(79,134,247,.15);
                color: #333;
                transform: translateX(4px);
            }

        .report-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: white;
            flex-shrink: 0;
        }

        .site-summary-row {
            padding: 14px 16px;
            border-bottom: 1px solid #f5f5f5;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .site-summary-row:last-child {
                border-bottom: none;
            }

        .alert-badge {
            padding: 4px 10px;
            border-radius: 99px;
            font-size: .75rem;
            font-weight: 600;
        }

        .filter-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            padding: 20px;
            margin-bottom: 20px;
        }

        .tbl-report th {
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #999;
            background: #f8f9fa;
        }

        .tbl-report td {
            font-size: .85rem;
            vertical-align: middle;
        }
    </style>
}

<div class="page-banner">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2" style="background:none;padding:0;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "SuperAdmin")" style="color:rgba(255,255,255,.75)"><i class="fas fa-th-large me-1"></i>Network</a></li>
                    <li class="breadcrumb-item active" style="color:white;">Consolidated Reports</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-1"><i class="fas fa-file-alt me-2"></i>Consolidated Reports</h4>
            <p class="mb-0" style="opacity:.85;font-size:.88rem;">Network-wide reports — All sites combined</p>
        </div>
        <a href="@Url.Action("Dashboard", "SuperAdmin")" class="btn btn-sm" style="background:rgba(255,255,255,.18);color:white;border:1px solid rgba(255,255,255,.3);">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

@* STATS *@
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div style="font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.5px;">Total Patients</div>
            <div style="font-size:2rem;font-weight:700;color:#4f86f7;line-height:1.1;">@Model.TotalPatients</div>
            <div style="font-size:.78rem;color:#aaa;"><i class="fas fa-arrow-up text-success me-1"></i>+@Model.PatientsThisMonth this month</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div style="font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.5px;">Total Procedures</div>
            <div style="font-size:2rem;font-weight:700;color:#28a745;line-height:1.1;">@Model.TotalProcedures</div>
            <div style="font-size:.78rem;color:#aaa;"><i class="fas fa-arrow-up text-success me-1"></i>+@Model.ProceduresThisMonth this month</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div style="font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.5px;">Inventory Items</div>
            <div style="font-size:2rem;font-weight:700;color:#17a2b8;line-height:1.1;">@Model.TotalItems</div>
            <div style="font-size:.78rem;color:#aaa;">Across all sites</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div style="font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.5px;">Low Stock Alerts</div>
            <div style="font-size:2rem;font-weight:700;color:#dc3545;line-height:1.1;">@Model.TotalLowStock</div>
            <div style="font-size:.78rem;color:#aaa;">Items need attention</div>
        </div>
    </div>
</div>

@* QUICK REPORTS *@
<div class="section-card">
    <h5><i class="fas fa-bolt me-2"></i>Quick Reports — Go to Existing Reports</h5>
    <div class="row g-3">
        <div class="col-md-3">
            <a href="@Url.Action("PatientReports", "Reports")" class="report-btn">
                <div class="report-icon" style="background:linear-gradient(135deg,#4f86f7,#3a75f5)"><i class="fas fa-user-injured"></i></div>
                <div>
                    <div class="fw-bold" style="font-size:.9rem;">Patient Reports</div>
                    <div style="font-size:.78rem;color:#888;">Demographics & analytics</div>
                    <small style="color:#4f86f7;"><i class="fas fa-arrow-right me-1"></i>Open</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("ProcedureReports", "Reports")" class="report-btn">
                <div class="report-icon" style="background:linear-gradient(135deg,#28a745,#34d058)"><i class="fas fa-procedures"></i></div>
                <div>
                    <div class="fw-bold" style="font-size:.9rem;">Procedure Reports</div>
                    <div style="font-size:.78rem;color:#888;">All procedures data</div>
                    <small style="color:#28a745;"><i class="fas fa-arrow-right me-1"></i>Open</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("InventoryReports", "Reports")" class="report-btn">
                <div class="report-icon" style="background:linear-gradient(135deg,#17a2b8,#00cfe8)"><i class="fas fa-boxes"></i></div>
                <div>
                    <div class="fw-bold" style="font-size:.9rem;">Inventory Reports</div>
                    <div style="font-size:.78rem;color:#888;">Stock & usage details</div>
                    <small style="color:#17a2b8;"><i class="fas fa-arrow-right me-1"></i>Open</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("ComparativeAnalytics", "SuperAdmin")" class="report-btn">
                <div class="report-icon" style="background:linear-gradient(135deg,#f093fb,#f5576c)"><i class="fas fa-balance-scale"></i></div>
                <div>
                    <div class="fw-bold" style="font-size:.9rem;">Comparative Analytics</div>
                    <div style="font-size:.78rem;color:#888;">Cross-site comparison</div>
                    <small style="color:#f5576c;"><i class="fas fa-arrow-right me-1"></i>Open</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("PerformanceMetrics", "SuperAdmin")" class="report-btn">
                <div class="report-icon" style="background:linear-gradient(135deg,#ffc107,#ffdb4d)"><i class="fas fa-trophy"></i></div>
                <div>
                    <div class="fw-bold" style="font-size:.9rem;">Performance Metrics</div>
                    <div style="font-size:.78rem;color:#888;">Site rankings & trends</div>
                    <small style="color:#ffc107;"><i class="fas fa-arrow-right me-1"></i>Open</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index", "Inventory")" class="report-btn">
                <div class="report-icon" style="background:linear-gradient(135deg,#fa709a,#fee140)"><i class="fas fa-warehouse"></i></div>
                <div>
                    <div class="fw-bold" style="font-size:.9rem;">Inventory Dashboard</div>
                    <div style="font-size:.78rem;color:#888;">Live stock levels</div>
                    <small style="color:#fa709a;"><i class="fas fa-arrow-right me-1"></i>Open</small>
                </div>
            </a>
        </div>
    </div>
</div>

@* SITE SUMMARIES + LOW STOCK *@
<div class="row g-3 mb-4">
    <div class="col-md-7">
        <div class="section-card">
            <h5><i class="fas fa-hospital me-2"></i>Network Summary by Site</h5>
            <div class="table-responsive">
                <table class="table tbl-report table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Site</th>
                            <th>Patients</th>
                            <th>Procedures</th>
                            <th>Completed</th>
                            <th>Items</th>
                            <th>Inventory</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Sites.Count; i++)
                        {
                            var site = Model.Sites[i];
                            <tr>
                                <td>
                                    <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:@Col(i);margin-right:6px;"></span>
                                    <strong>@site.SiteName</strong>
                                    <div style="font-size:.75rem;color:#aaa;">@site.SiteCity</div>
                                </td>
                                <td>@site.TotalPatients</td>
                                <td>@site.TotalProcedures</td>
                                <td><span class="badge bg-success">@site.CompletedProcedures</span></td>
                                <td>@site.TotalItems</td>
                                <td><span class="badge bg-@site.InventoryStatusClass">@site.InventoryStatus</span></td>
                                <td>
                                    <a href="@Url.Action("SiteDetail", "SuperAdmin", new { id = site.SiteId })"
                                       class="btn btn-outline-primary" style="font-size:.72rem;padding:3px 10px;">View</a>
                                </td>
                            </tr>
                        }
                        <tr class="table-light fw-bold">
                            <td>TOTAL</td>
                            <td>@Model.TotalPatients</td>
                            <td>@Model.TotalProcedures</td>
                            <td>@Model.Sites.Sum(s => s.CompletedProcedures)</td>
                            <td>@Model.TotalItems</td>
                            <td>—</td>
                            <td>—</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="section-card">
            <h5>
                <i class="fas fa-exclamation-triangle me-2"></i>Low Stock Alerts
                @if (Model.TotalLowStock > 0)
                {
                    <span class="badge bg-danger ms-1">@Model.TotalLowStock</span>
                }
            </h5>
            @if (!Model.LowStockAlerts.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="fas fa-check-circle fa-2x text-success mb-2 d-block"></i>
                    All sites — stock levels normal
                </div>
            }
            else
            {
                @foreach (var alert in Model.LowStockAlerts)
                {
                    <div style="display:flex;align-items:center;gap:12px;padding:11px 14px;border-left:4px solid @(alert.StatusClass == "danger" ? "#dc3545" : "#ffc107");background:#f8fafc;border-radius:0 10px 10px 0;margin-bottom:8px;">
                        <div style="width:32px;height:32px;border-radius:8px;background:@(alert.StatusClass == "danger" ? "#fff0f0" : "#fff8e1");display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="fas @(alert.StatusClass == "danger" ? "fa-times-circle text-danger" : "fa-exclamation-triangle text-warning")"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div style="font-size:.83rem;font-weight:600;">@alert.ItemName</div>
                            <div style="font-size:.75rem;color:#888;">@alert.SiteName · @alert.CurrentStock @alert.Unit remaining</div>
                        </div>
                        <span class="badge bg-@alert.StatusClass">@alert.Status</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@* NAVIGATION TO SITE DETAIL PAGES *@
<div class="section-card">
    <h5><i class="fas fa-map-marked-alt me-2"></i>Individual Site Reports</h5>
    <div class="row g-3">
        @for (int i = 0; i < Model.Sites.Count; i++)
        {
            var site = Model.Sites[i];
            <div class="col-md-4">
                <a href="@Url.Action("SiteDetail", "SuperAdmin", new { id = site.SiteId })" class="report-btn">
                    <div class="report-icon" style="background:@Col(i)">
                        <i class="fas fa-hospital"></i>
                    </div>
                    <div>
                        <div class="fw-bold" style="font-size:.9rem;">@site.SiteName</div>
                        <div style="font-size:.78rem;color:#888;">
                            @site.TotalPatients patients · @site.TotalProcedures procedures
                        </div>
                        <span class="badge bg-@site.InventoryStatusClass" style="font-size:.7rem;">@site.InventoryStatus</span>
                    </div>
                </a>
            </div>
        }
    </div>
</div>
