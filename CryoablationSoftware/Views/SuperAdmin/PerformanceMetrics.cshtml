@* Views/SuperAdmin/PerformanceMetrics.cshtml *@
@model CryoablationSoftware.ViewModel.PerformanceMetricsViewModel
@{
    ViewData["Title"] = "Performance Metrics";
    var siteColors = new[] { "#4f86f7", "#28a745", "#ffc107", "#17a2b8", "#f093fb", "#fa709a", "#fd7e14", "#20c997" };
    string Col(int i) => siteColors[i % siteColors.Length];
    var ranked = Model.Sites.OrderByDescending(s => s.CompletionRate).ToList();
}

@section Styles {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .page-banner {
            background: linear-gradient(135deg,rgba(79,134,247,.95),rgba(58,117,245,.9));
            color: white;
            padding: 22px 28px 50px;
            margin: -32px -12px 0;
            border-radius: 0 0 20px 20px;
        }

        .highlight-banner {
            background: linear-gradient(135deg,#4f86f7,#3a75f5);
            color: white;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 20px;
        }

        .kpi-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            padding: 20px;
        }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 20px rgba(79,134,247,.15);
            }

        .kpi-icon {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: white;
        }

        .section-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            padding: 20px;
            margin-bottom: 20px;
        }

            .section-card h5 {
                font-size: .95rem;
                font-weight: 700;
                color: #333;
                margin-bottom: 16px;
            }

                .section-card h5 i {
                    color: #4f86f7;
                }

        .leaderboard-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: #f8fafc;
            border-radius: 10px;
            margin-bottom: 8px;
            transition: transform .2s;
        }

            .leaderboard-row:hover {
                transform: translateX(5px);
            }

        .rank-badge {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .rank-1 {
            background: linear-gradient(135deg,#FFD700,#FFA500);
            color: white;
        }

        .rank-2 {
            background: linear-gradient(135deg,#C0C0C0,#A9A9A9);
            color: white;
        }

        .rank-3 {
            background: linear-gradient(135deg,#CD7F32,#8B4513);
            color: white;
        }

        .rank-other {
            background: #e9ecef;
            color: #666;
        }

        .perf-tbl th {
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #999;
            background: #f8f9fa;
        }

        .perf-tbl td {
            font-size: .85rem;
            vertical-align: middle;
        }

        .perf-tbl tbody tr:hover {
            background: #f0f4ff;
        }

        .completion-bar {
            height: 8px;
            border-radius: 99px;
            background: #eee;
            overflow: hidden;
            margin-top: 4px;
        }

        .completion-fill {
            height: 100%;
            border-radius: 99px;
        }
    </style>
}

<div class="page-banner">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2" style="background:none;padding:0;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "SuperAdmin")" style="color:rgba(255,255,255,.75)"><i class="fas fa-th-large me-1"></i>Network</a></li>
                    <li class="breadcrumb-item active" style="color:white;">Performance Metrics</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-1"><i class="fas fa-trophy me-2"></i>Performance Metrics & Analytics</h4>
            <p class="mb-0" style="opacity:.85;font-size:.88rem;">Procedure completion rates and site performance rankings</p>
        </div>
        <a href="@Url.Action("Dashboard", "SuperAdmin")" class="btn btn-sm" style="background:rgba(255,255,255,.18);color:white;border:1px solid rgba(255,255,255,.3);">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

@* HIGHLIGHT BANNER *@
@if (ranked.Any())
{
    var top = ranked.First();
    <div class="highlight-banner mt-3">
        <div class="row align-items-center">
            <div class="col-md-9">
                <h4 class="mb-1"><i class="fas fa-star me-2"></i>Network Performance Summary</h4>
                <p class="mb-0" style="opacity:.9;">
                    <strong>@top.SiteName</strong> leads with <strong>@top.CompletionRate%</strong> procedure completion rate.
                    Network total: <strong>@Model.TotalProcedures</strong> procedures across <strong>@Model.Sites.Count</strong> active sites.
                </p>
            </div>
            <div class="col-md-3 text-end">
                <span style="font-size:4rem;">🏆</span>
            </div>
        </div>
    </div>
}

@* KPI CARDS *@
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:linear-gradient(135deg,#28a745,#34d058)"><i class="fas fa-procedures"></i></div>
                <div>
                    <div style="font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.5px;">Total Procedures</div>
                    <div style="font-size:1.9rem;font-weight:700;color:#28a745;line-height:1;">@Model.TotalProcedures</div>
                    <div style="font-size:.78rem;color:#aaa;">All sites combined</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:linear-gradient(135deg,#4f86f7,#3a75f5)"><i class="fas fa-users"></i></div>
                <div>
                    <div style="font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.5px;">Total Patients</div>
                    <div style="font-size:1.9rem;font-weight:700;color:#4f86f7;line-height:1;">@Model.TotalPatients</div>
                    <div style="font-size:.78rem;color:#aaa;">All sites combined</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:linear-gradient(135deg,#17a2b8,#00cfe8)"><i class="fas fa-check-double"></i></div>
                <div>
                    <div style="font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.5px;">Total Completed</div>
                    <div style="font-size:1.9rem;font-weight:700;color:#17a2b8;line-height:1;">@Model.Sites.Sum(s => s.CompletedProcedures)</div>
                    <div style="font-size:.78rem;color:#aaa;">
                        @(Model.TotalProcedures > 0 ? Math.Round((double)Model.Sites.Sum(s => s.CompletedProcedures) / Model.TotalProcedures * 100, 1) : 0)% network rate
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:linear-gradient(135deg,#ffc107,#ffdb4d)"><i class="fas fa-exclamation-triangle"></i></div>
                <div>
                    <div style="font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.5px;">Inventory Issues</div>
                    <div style="font-size:1.9rem;font-weight:700;color:#ffc107;line-height:1;">@Model.Sites.Count(s => s.LowStockCount > 0 || s.OutOfStockCount > 0)</div>
                    <div style="font-size:.78rem;color:#aaa;">Sites with low/out stock</div>
                </div>
            </div>
        </div>
    </div>
</div>

@* LEADERBOARD + TREND CHART *@
<div class="row g-3 mb-4">
    <div class="col-md-5">
        <div class="section-card">
            <h5><i class="fas fa-trophy me-2"></i>Site Performance Leaderboard <small style="font-size:.75rem;color:#aaa;">(by completion rate)</small></h5>
            @for (int i = 0; i < ranked.Count; i++)
            {
                var site = ranked[i];
                <div class="leaderboard-row">
                    <div class="rank-badge @(i == 0 ? "rank-1" : i == 1 ? "rank-2" : i == 2 ? "rank-3" : "rank-other")">@(i + 1)</div>
                    <div class="flex-grow-1">
                        <div class="fw-bold" style="font-size:.88rem;">@site.SiteName</div>
                        <div style="font-size:.75rem;color:#888;">@site.SiteCity · @site.TotalProcedures total procedures</div>
                        <div class="completion-bar mt-1">
                            <div class="completion-fill" style="width:@(site.CompletionRate)%;background:@Col(Model.Sites.IndexOf(site));"></div>
                        </div>
                    </div>
                    <div class="text-end" style="min-width:60px;">
                        <div style="font-size:1.1rem;font-weight:700;color:@(site.CompletionRate >= 80 ? "#28a745" : site.CompletionRate >= 60 ? "#ffc107" : "#dc3545");">
                            @site.CompletionRate%
                        </div>
                        <div style="font-size:.72rem;color:#aaa;">completion</div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-md-7">
        <div class="section-card">
            <h5><i class="fas fa-chart-line me-2"></i>Monthly Procedures Trend (Last 6 Months)</h5>
            <canvas id="trendChart" height="200"></canvas>
        </div>
    </div>
</div>

@* DETAILED PERFORMANCE TABLE *@
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="section-card">
            <h5><i class="fas fa-tachometer-alt me-2"></i>Detailed Performance Summary</h5>
            <div class="table-responsive">
                <table class="table perf-tbl table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Site</th>
                            <th>City</th>
                            <th>Patients</th>
                            <th>Total Proc.</th>
                            <th>Completed</th>
                            <th>This Month</th>
                            <th>Completion Rate</th>
                            <th>Inventory</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < ranked.Count; i++)
                        {
                            var site = ranked[i];
                            int siteIdx = Model.Sites.IndexOf(site);
                            <tr>
                                <td>
                                    <div class="rank-badge @(i == 0 ? "rank-1" : i == 1 ? "rank-2" : i == 2 ? "rank-3" : "rank-other")"
                                         style="width:30px;height:30px;font-size:.85rem;">
                                        @(i + 1)
                                    </div>
                                </td>
                                <td>
                                    <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:@Col(siteIdx);margin-right:6px;"></span>
                                    <strong>@site.SiteName</strong>
                                </td>
                                <td class="text-muted">@site.SiteCity</td>
                                <td><span class="badge bg-primary">@site.TotalPatients</span></td>
                                <td><span class="badge bg-info text-white">@site.TotalProcedures</span></td>
                                <td><span class="badge bg-success">@site.CompletedProcedures</span></td>
                                <td><span class="badge bg-secondary">@site.ProceduresThisMonth</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="flex:1;height:6px;background:#eee;border-radius:99px;overflow:hidden;">
                                            <div style="height:100%;width:@(site.CompletionRate)%;background:@(site.CompletionRate >= 80 ? "#28a745" : site.CompletionRate >= 60 ? "#ffc107" : "#dc3545");border-radius:99px;"></div>
                                        </div>
                                        <span class="fw-bold" style="min-width:42px;font-size:.83rem;color:@(site.CompletionRate >= 80 ? "#28a745" : site.CompletionRate >= 60 ? "#ffc107" : "#dc3545")">
                                            @site.CompletionRate%
                                        </span>
                                    </div>
                                </td>
                                <td><span class="badge bg-@site.InventoryStatusClass">@site.InventoryStatus</span></td>
                                <td>
                                    <a href="@Url.Action("SiteDetail", "SuperAdmin", new { id = site.SiteId })"
                                       class="btn btn-outline-primary" style="font-size:.72rem;padding:3px 10px;">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const sites = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sites.Select(s => s.SiteName)));
        const colors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Enumerable.Range(0, Model.Sites.Count).Select(i => Col(i)).ToArray()));
        const months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(t => t.Month).Distinct().ToArray()));
        const allTrends = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends));
        const datasets = sites.map((name, idx) => ({
            label: name,
            data: months.map(m => { const f = allTrends.find(t => t.SiteName === name && t.Month === m); return f ? f.ProcedureCount : 0; }),
            borderColor: colors[idx], backgroundColor: colors[idx] + '18', tension: 0.4, borderWidth: 2, pointRadius: 3
        }));
        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: { labels: months, datasets },
            options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } }, scales: { y: { beginAtZero: true, grid: { color: '#f5f5f5' } }, x: { grid: { display: false } } } }
        });
    </script>
}
