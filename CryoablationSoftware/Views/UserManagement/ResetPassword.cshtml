@model CryoablationSoftware.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-key"></i> Reset Password</h2>
                <a href="@Url.Action("Index", "UserManagement")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Users
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-warning">
                        <i class="fas fa-user"></i> Resetting password for: <strong>@Model.FullName</strong>
                    </h6>
                </div>
                <div class="card-body">
                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="FullName" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold">New Password *</label>
                            <input asp-for="NewPassword" class="form-control" type="password"
                                   placeholder="Minimum 6 characters" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirm Password *</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password"
                                   placeholder="Repeat the password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-end gap-2">
                            <a href="@Url.Action("Index", "UserManagement")" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-key"></i> Reset Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
