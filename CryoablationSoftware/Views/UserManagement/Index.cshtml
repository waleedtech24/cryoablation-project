@model List<CryoablationSoftware.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-users-cog"></i> User Management</h2>
            <small class="text-muted">Manage all system users</small>
        </div>
        <a href="@Url.Action("Create", "UserManagement")" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> Add New User
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body">
                    <h3 class="text-primary">@Model.Count</h3>
                    <small class="text-muted">Total Users</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body">
                    <h3 class="text-success">@Model.Count(u => u.IsActive)</h3>
                    <small class="text-muted">Active</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body">
                    <h3 class="text-warning">@Model.Count(u => u.UserRole == "Super Admin")</h3>
                    <small class="text-muted">Super Admins</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body">
                    <h3 class="text-info">@Model.Count(u => u.SiteId.HasValue)</h3>
                    <small class="text-muted">Site Users</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No users found.</p>
                    <a href="@Url.Action("Create", "UserManagement")" class="btn btn-primary">
                        <i class="fas fa-user-plus"></i> Add First User
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="usersTable">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Site</th>
                                <th>Designation</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (user, index) in Model.Select((u, i) => (u, i + 1)))
                            {
                                <tr class="@(!user.IsActive ? "table-secondary" : "")">
                                    <td>@index</td>
                                    <td>
                                        <strong>@user.FullName</strong>
                                        <br />
                                        <small class="text-muted">Added @user.CreatedAt.ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        @{
                                            var roleClass = user.UserRole switch
                                            {
                                                "Super Admin" => "bg-danger",
                                                "Admin" => "bg-warning text-dark",
                                                "Manager" => "bg-info text-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @roleClass">@user.UserRole</span>
                                    </td>
                                    <td>
                                        @if (user.SiteId.HasValue)
                                        {
                                            <span><i class="fas fa-hospital-alt text-primary"></i> @user.SiteName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="fas fa-globe"></i> All Sites</span>
                                        }
                                    </td>
                                    <td>@(user.Designation ?? "-")</td>
                                    <td class="text-center">
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Edit", "UserManagement", new { id = user.UserId })"
                                               class="btn btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="@Url.Action("ResetPassword", "UserManagement", new { id = user.UserId })"
                                               class="btn btn-outline-warning" title="Reset Password">
                                                <i class="fas fa-key"></i>
                                            </a>
                                            <form method="post"
                                                  asp-action="ToggleStatus"
                                                  asp-route-id="@user.UserId"
                                                  style="display:inline;"
                                                  onsubmit="return confirm('@(user.IsActive ? "Deactivate" : "Activate") user @user.FullName?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-outline-@(user.IsActive ? "danger" : "success")"
                                                        title="@(user.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="fas @(user.IsActive ? "fa-ban" : "fa-check")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#usersTable').DataTable({
                order: [[1, 'asc']],
                pageLength: 15
            });
        });
    </script>
}
