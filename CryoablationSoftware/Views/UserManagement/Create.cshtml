@model CryoablationSoftware.ViewModels.UserFormViewModel
@{
    ViewData["Title"] = "Add New User";
    bool isEdit = Model.UserId != null;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-user-plus"></i> Add New User</h2>
                <a href="@Url.Action("Index", "UserManagement")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Users
                </a>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-user"></i> User Information
                    </h6>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label fw-bold">Full Name *</label>
                                <input asp-for="FullName" class="form-control" placeholder="e.g., Muhammad Ali" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Designation" class="form-label">Designation</label>
                                <input asp-for="Designation" class="form-control" placeholder="e.g., Hospital Manager" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-bold">Email *</label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="e.g., user@hospital.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-bold">Password *</label>
                                <input asp-for="Password" class="form-control" type="password" placeholder="Minimum 6 characters" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserRole" class="form-label fw-bold">Role *</label>
                                <select asp-for="UserRole" class="form-control" id="roleSelect">
                                    <option value="">-- Select Role --</option>
                                    <option value="Super Admin">Super Admin</option>
                                    <option value="Admin">Admin</option>
                                    <option value="Manager">Manager</option>
                                </select>
                                <span asp-validation-for="UserRole" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3" id="siteSection">
                                <label asp-for="SiteId" class="form-label fw-bold">Site *</label>
                                <select asp-for="SiteId" class="form-control">
                                    <option value="">-- Select Site --</option>
                                    @foreach (var site in Model.AvailableSites)
                                    {
                                        <option value="@site.SiteId">@site.SiteName (@site.SiteCity)</option>
                                    }
                                </select>
                                <span asp-validation-for="SiteId" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-end gap-2">
                            <a href="@Url.Action("Index", "UserManagement")" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Create User
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Super Admin select ho toh Site dropdown hide karo
        document.getElementById('roleSelect').addEventListener('change', function () {
            var siteSection = document.getElementById('siteSection');
            if (this.value === 'Super Admin') {
                siteSection.style.display = 'none';
            } else {
                siteSection.style.display = 'block';
            }
        });
    </script>
}
