@model IEnumerable<CryoablationSoftware.Models.Patient>
@{
    ViewData["Title"] = "Patients Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="mb-2">
                <i class="bi bi-people-fill text-primary"></i> Patients Management
            </h2>
            <p class="text-muted">View and manage all registered patients</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Create", "Patients")" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Add New Patient
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">Total Patients</h6>
                            <h3 class="mb-0">@Model.Count()</h3>
                        </div>
                        <i class="bi bi-people fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">Active Patients</h6>
                            <h3 class="mb-0">@Model.Count(p => p.IsActive)</h3>
                        </div>
                        <i class="bi bi-person-check fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">With Procedures</h6>
                            <h3 class="mb-0">@Model.Count(p => p.Procedures != null && p.Procedures.Any())</h3>
                        </div>
                        <i class="bi bi-clipboard2-pulse fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-dark-50 mb-1">New This Month</h6>
                            <h3 class="mb-0">@Model.Count(p => p.CreatedAt.Month == DateTime.Now.Month && p.CreatedAt.Year == DateTime.Now.Year)</h3>
                        </div>
                        <i class="bi bi-calendar-plus fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Patients Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0"><i class="bi bi-table"></i> All Patients</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="patientsTable" class="table table-hover table-bordered align-middle" style="width:100%">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="bi bi-hash"></i> MR Number</th>
                            <th><i class="bi bi-person"></i> Patient Name</th>
                            <th><i class="bi bi-credit-card"></i> CNIC</th>
                            <th><i class="bi bi-telephone"></i> Phone</th>
                            <th><i class="bi bi-geo-alt"></i> City</th>
                            <th><i class="bi bi-gender-ambiguous"></i> Gender</th>
                            <th><i class="bi bi-calendar"></i> Registration Date</th>
                            <th><i class="bi bi-clipboard2-pulse"></i> Procedures</th>
                            <th><i class="bi bi-gear"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr class="@(patient.IsActive ? "" : "table-secondary")">
                                <td><strong>@patient.PatientMRNumber</strong></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-primary text-white me-2" style="width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                            @patient.PatientName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold">@patient.PatientName</div>
                                            <small class="text-muted">Age: @patient.PatientAge</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@(patient.PatientCNIC ?? "N/A")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(patient.PatientPhone))
                                    {
                                        <a href="tel:@patient.PatientPhone" class="text-decoration-none">
                                            <i class="bi bi-telephone-fill text-success"></i> @patient.PatientPhone
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>@(patient.PatientCity ?? "N/A")</td>
                                <td>
                                    @if (patient.PatientGender?.ToLower() == "male")
                                    {
                                        <span class="badge bg-info"><i class="bi bi-gender-male"></i> Male</span>
                                    }
                                    else if (patient.PatientGender?.ToLower() == "female")
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-gender-female"></i> Female</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Other</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-nowrap">
                                        <i class="bi bi-calendar-check text-primary"></i>
                                        @patient.CreatedAt.ToString("dd-MMM-yyyy")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @{
                                        var procedureCount = patient.Procedures?.Count() ?? 0;
                                    }
                                    @if (procedureCount > 0)
                                    {
                                        <span class="badge bg-success rounded-pill">@procedureCount</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill">0</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="@Url.Action("Details", "Patients", new { id = patient.PatientId })"
                                           class="btn btn-info"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", "Patients", new { id = patient.PatientId })"
                                           class="btn btn-primary"
                                           title="Edit Patient">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (procedureCount > 0)
                                        {
                                            <a href="@Url.Action("PatientProcedures", "Patients", new { id = patient.PatientId })"
                                               class="btn btn-success"
                                               title="View Procedures">
                                                <i class="bi bi-clipboard2-pulse"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#patientsTable').DataTable({
                responsive: true,
                pageLength: 25,
                order: [[6, "desc"]], // Sort by Registration Date (newest first)
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search patients...",
                    lengthMenu: "Show _MENU_ patients per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ patients",
                    infoEmpty: "No patients found",
                    infoFiltered: "(filtered from _MAX_ total patients)",
                    paginate: {
                        first: '<i class="bi bi-chevron-double-left"></i>',
                        last: '<i class="bi bi-chevron-double-right"></i>',
                        next: '<i class="bi bi-chevron-right"></i>',
                        previous: '<i class="bi bi-chevron-left"></i>'
                    }
                },
                columnDefs: [
                    { orderable: false, targets: [8] }, // Actions column non-sortable
                    { className: "text-center", targets: [7, 8] }
                ],
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                    '<"row"<"col-sm-12"tr>>' +
                    '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
            });

            // Add custom styling to search box
            $('.dataTables_filter input').addClass('form-control form-control-sm');
            $('.dataTables_length select').addClass('form-select form-select-sm');
        });
    </script>
}

<style>
    .avatar-circle {
        font-weight: bold;
        font-size: 16px;
    }

    .card {
        border: none;
        border-radius: 10px;
    }

    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .btn-group-sm > .btn {
        padding: 0.25rem 0.5rem;
    }

    #patientsTable_wrapper .row {
        margin-bottom: 1rem;
    }
</style>